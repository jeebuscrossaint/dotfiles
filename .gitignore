*coat*
!/linux/.config/coat/
!/linux/.config/coat/coat.yaml
# ~/.config/coat is stow-symlinked, so anything coat GENERATES in there lands in
# this tree. coat.yaml above is the hand-written one; the rest is output.
/linux/.config/coat/msteams.css
linux/.config/coat/schemes/

# coat-webapps is SOURCE, not coat output -- coat never writes any of it, so the
# blanket *coat* rule above is wrong for it. The directory has to be un-ignored
# before its contents can be: git will not re-include a file underneath an
# excluded directory, and `coat-webapps` matches *coat* itself.
!/linux/.local/share/coat-webapps/
!/linux/.local/share/coat-webapps/**
# Build artifact: `build-xpi.py` regenerates it from extension/.
linux/.local/share/coat-webapps/coat-webapps.xpi
!/linux/.local/bin/coat-webapp-host

# Files coat OWNS entirely (it rewrites them on every `coat set`), as opposed to
# the fragments it writes alongside a config — those already match the *coat*
# rule above. These tools have no include mechanism, so coat generates the
# whole file and tracking them would mean a dirty tree after every theme change.
# The templates that produce them live in ~/Projects/coat/templates/.
linux/.config/wob/wob.ini

# There is NO rule for the notification daemon or the lock screen, and that is
# the point. coat writes dunstrc.d/50-coat.conf and swaylock/coat-theme.conf, and
# because both config directories are real directories rather than folded stow
# symlinks, neither file is inside this tree to begin with. Nothing to ignore.

# py_compile droppings — the scripts in .local/bin are run directly, never imported.
__pycache__/
*.pyc

# Browser profiles. ~/.config/chromium is stow-adjacent and lands in this tree,
# and it holds Cookies, Login Data and Web Data -- live session credentials.
# This remote is public; none of it is config worth tracking.
linux/.config/chromium/

# micro's open-buffer state, not configuration.
linux/.config/micro/buffers/
