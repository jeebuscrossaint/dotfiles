 void
 inputdevice(struct wl_listener *listener, void *data)
 {
@@ -2521,8 +2624,12 @@ monocle(Monitor *m)
 	wl_list_for_each(c, &clients, link) {
 		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
 			continue;
-		resize(c, m->w, 0);
 		n++;
+		if (!monoclegaps)
+			resize(c, m->w, 0);
+		else
+			resize(c, (struct wlr_box){.x = m->w.x + gappoh, .y = m->w.y + gappov,
+				.width = m->w.width - 2 * gappoh, .height = m->w.height - 2 * gappov}, 0);
 	}
 	if (n)
 		snprintf(m->ltsymbol, LENGTH(m->ltsymbol), "[%d]", n);
@@ -3309,6 +3416,16 @@ setfullscreen(Client *c, int fullscreen)
 	drawbars();
 }
 
+void
+setgaps(int oh, int ov, int ih, int iv)
+{
+	selmon->gappoh = MAX(oh, 0);
+	selmon->gappov = MAX(ov, 0);
+	selmon->gappih = MAX(ih, 0);
+	selmon->gappiv = MAX(iv, 0);
+	arrange(selmon);
+}
+
 void
 setlayout(const Arg *arg)
 {
@@ -3900,8 +4017,8 @@ termforwin(Client *c)
 void
 tile(Monitor *m)
 {
-	unsigned int mw, my, ty;
-	int i, n = 0;
+	unsigned int mw, my, ty, h, oe = enablegaps, ie = enablegaps;
+	int i, n = 0, mn = 0, tn = 0, mavail, tavail;
 	float mweight = 0, tweight = 0;
 	Client *c;
 
@@ -3911,32 +4028,49 @@ tile(Monitor *m)
 	if (n == 0)
 		return;
 
+	if (smartgaps == n)
+		oe = 0; /* outer gaps disabled */
+
 	if (n > m->nmaster)
-		mw = m->nmaster ? (int)roundf(m->w.width * m->mfact) : 0;
+		mw = m->nmaster ? (int)roundf((m->w.width + m->gappiv*ie) * m->mfact) : 0;
 	else
-		mw = m->w.width;
+		mw = m->w.width - 2*m->gappov*oe + m->gappiv*ie;
+
+	/* cfact: sum the client weights, and count clients, per column */
 	i = 0;
-	wl_list_for_each(c, &clients, link){
+	wl_list_for_each(c, &clients, link) {
 		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
 			continue;
-		if (i < m->nmaster)
+		if (i < m->nmaster) {
 			mweight += c->cweight;
-		else
+			mn++;
+		} else {
 			tweight += c->cweight;
+			tn++;
+		}
 		i++;
 	}
-	i = my = ty = 0;
+
+	/* height each column has left once the gaps are taken out */
+	mavail = m->w.height - 2*m->gappoh*oe - m->gappih*ie * (mn > 0 ? mn - 1 : 0);
+	tavail = m->w.height - 2*m->gappoh*oe - m->gappih*ie * (tn > 0 ? tn - 1 : 0);
+
+	i = 0;
+	my = ty = m->gappoh*oe;
 	wl_list_for_each(c, &clients, link) {
 		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
 			continue;
 		if (i < m->nmaster) {
-			resize(c, (struct wlr_box){.x = m->w.x, .y = m->w.y + my, .width = mw,
-				.height = (int) ((c->cweight / mweight) * m->w.height)}, 0);
-			my += c->geom.height;
+			/* distribute the gap-adjusted height by cfact weight */
+			h = mweight > 0 ? (unsigned int)((c->cweight / mweight) * mavail) : 0;
+			resize(c, (struct wlr_box){.x = m->w.x + m->gappov*oe, .y = m->w.y + my,
+				.width = mw - m->gappiv*ie, .height = h}, 0);
+			my += c->geom.height + m->gappih*ie;
 		} else {
-			resize(c, (struct wlr_box){.x = m->w.x + mw, .y = m->w.y + ty,
-				.width = m->w.width - mw, .height = (int) ((c->cweight / tweight) * m->w.height) }, 0);
-			ty += c->geom.height;
+			h = tweight > 0 ? (unsigned int)((c->cweight / tweight) * tavail) : 0;
+			resize(c, (struct wlr_box){.x = m->w.x + mw + m->gappov*oe, .y = m->w.y + ty,
+				.width = m->w.width - mw - 2*m->gappov*oe, .height = h}, 0);
+			ty += c->geom.height + m->gappih*ie;
 		}
 		i++;
 	}
@@ -4064,6 +4198,13 @@ togglefullscreenadaptivesync(const Arg *arg)
 	fullscreen_adaptive_sync_enabled = !fullscreen_adaptive_sync_enabled;
 }
 
+void
+togglegaps(const Arg *arg)
+{
+	enablegaps = !enablegaps;
+	arrange(selmon);
+}
+
 void
 toggletag(const Arg *arg)
 {
