From b26c94a54ed2d7e706869c592cd6d745d63e7237 Mon Sep 17 00:00:00 2001
From: jeebuscrossaint <thediamond270@gmail.com>
Date: Sat, 15 Aug 2026 21:27:14 -0400
Subject: [PATCH 09/29] patch: mastercolumn - master area split into nmaster+1
 columns

Conflict: patch is 0.7-era and carried a whole stale keybind block. Kept ours
(which has bar's togglebar and btrtile's swapclients/setratio binds).
---
 config.def.h |  1 +
 dwl.c        | 36 ++++++++++++++++++++++++++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/config.def.h b/config.def.h
index 2382ead..18dd603 100644
--- a/config.def.h
+++ b/config.def.h
@@ -53,6 +53,7 @@ static const Layout layouts[] = {
 	{ "###",      gaplessgrid },
 	{ "[E]",      deck },
 	{ "@|@",      snail },
+	{ "||=",      mastercol },
 };
 
 /* monitors */
diff --git a/dwl.c b/dwl.c
index f1457ff..1010e29 100644
--- a/dwl.c
+++ b/dwl.c
@@ -340,6 +340,7 @@ static int keyrepeat(void *data);
 static void killclient(const Arg *arg);
 static void locksession(struct wl_listener *listener, void *data);
 static void mapnotify(struct wl_listener *listener, void *data);
+static void mastercol(Monitor *m);
 static void maximizenotify(struct wl_listener *listener, void *data);
 static void monocle(Monitor *m);
 static void motionabsolute(struct wl_listener *listener, void *data);
@@ -2206,6 +2207,41 @@ unset_fullscreen:
 	}
 }
 
+void
+mastercol(Monitor *m)
+{
+	unsigned int mw, mx, ty;
+	int i, n = 0;
+	Client *c;
+
+	wl_list_for_each(c, &clients, link)
+		if (VISIBLEON(c, m) && !c->isfloating && !c->isfullscreen)
+			n++;
+	if (n == 0)
+		return;
+
+	if (n > m->nmaster)
+		mw = m->nmaster ? (int)roundf(m->w.width * m->mfact) : 0;
+	else
+		mw = m->w.width;
+	i = mx = ty = 0;
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+			continue;
+		if (i < m->nmaster) {
+			resize(c, (struct wlr_box){.x = m->w.x + mx, .y = m->w.y,
+				.width = (mw - mx) / (MIN(n, m->nmaster) - i), .height = m->w.height}, 0);
+			mx += c->geom.width;
+		} else {
+			resize(c, (struct wlr_box){.x = m->w.x + mw, .y = m->w.y + ty,
+				.width = m->w.width - mw, .height = (m->w.height - ty) / (n - i)}, 0);
+			ty += c->geom.height;
+		}
+		i++;
+	}
+}
+
+
 void
 maximizenotify(struct wl_listener *listener, void *data)
 {
