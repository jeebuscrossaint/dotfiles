From f065fc294f43463f978ceae42241b2da627f148d Mon Sep 17 00:00:00 2001
From: jeebuscrossaint <thediamond270@gmail.com>
Date: Sat, 15 Aug 2026 21:34:12 -0400
Subject: [PATCH 18/29] patch: spawnorfocus - run-or-raise by app_id/title
 substring

Conflict: stale 0.7 keybind block, kept ours. Bound Mod+Shift+b to
spawnorfocus browsercmd, and moved toggleswallow off Mod+a (collided with
the deck layout bind) to Mod+x.
---
 config.def.h |  8 ++++++--
 dwl.c        | 27 +++++++++++++++++++++++++++
 2 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/config.def.h b/config.def.h
index dd8ba59..44aa921 100644
--- a/config.def.h
+++ b/config.def.h
@@ -149,7 +149,10 @@ static const int cursor_timeout = 5;
 #define SHCMD(cmd) { .v = (const char*[]){ "/bin/sh", "-c", cmd, NULL } }
 
 /* commands */
-static const char *termcmd[] = { "foot", NULL };
+/* The third element is used by the 'spawnorfocus' function to match a title/app_id.
+ * If the third element is 'NULL', match on the first element instead */
+static const char *termcmd[] = { "foot", NULL, NULL };
+static const char *browsercmd[] = { "firefox", NULL, "Mozilla Firefox" };
 static const char *menucmd[] = { "wmenu-run", NULL };
 
 static const Key keys[] = {
@@ -158,6 +161,7 @@ static const Key keys[] = {
 	{ MODKEY,                    XKB_KEY_p,           spawn,            {.v = menucmd} },
 	{ MODKEY|WLR_MODIFIER_SHIFT, XKB_KEY_Return,      spawn,            {.v = termcmd} },
 	{ MODKEY,                    XKB_KEY_b,           togglebar,        {0} },
+	{ MODKEY|WLR_MODIFIER_SHIFT, XKB_KEY_b,           spawnorfocus,     {.v = browsercmd} },
 	{ MODKEY,                    XKB_KEY_j,           focusstack,       {.i = +1} },
 	{ MODKEY,                    XKB_KEY_k,           focusstack,       {.i = -1} },
 	{ MODKEY|WLR_MODIFIER_SHIFT, XKB_KEY_j,           movestack,        {.i = +1} },
@@ -190,7 +194,7 @@ static const Key keys[] = {
 	{ MODKEY,                    XKB_KEY_space,       setlayout,        {0} },
 	{ MODKEY|WLR_MODIFIER_SHIFT, XKB_KEY_space,       togglefloating,   {0} },
 	{ MODKEY,                    XKB_KEY_e,           togglefullscreen, {0} },
-	{ MODKEY,                    XKB_KEY_a,           toggleswallow,    {0} },
+	{ MODKEY,                    XKB_KEY_x,           toggleswallow,    {0} },
 	{ MODKEY|WLR_MODIFIER_SHIFT, XKB_KEY_A,           toggleautoswallow,{0} },
 	{ MODKEY,                    XKB_KEY_0,           view,             {.ui = ~0} },
 	{ MODKEY|WLR_MODIFIER_SHIFT, XKB_KEY_parenright,  tag,              {.ui = ~0} },
diff --git a/dwl.c b/dwl.c
index beef812..0187207 100644
--- a/dwl.c
+++ b/dwl.c
@@ -11,6 +11,7 @@
 #include <signal.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 #include <sys/wait.h>
 #include <time.h>
 #include <unistd.h>
@@ -395,6 +396,7 @@ static void setratio_v(const Arg *arg);
 static void swapclients(const Arg *arg);
 static void snail(Monitor *m);
 static void spawn(const Arg *arg);
+static void spawnorfocus(const Arg *arg);
 static void startdrag(struct wl_listener *listener, void *data);
 static int statusin(int fd, unsigned int mask, void *data);
 static void swallow(Client *c, Client *toswallow);
@@ -3543,6 +3545,31 @@ spawn(const Arg *arg)
 	}
 }
 
+void
+spawnorfocus(const Arg *arg)
+{
+	char *needle;
+	Client *c;
+	int i = 0;
+
+	while (((char **)arg->v)[i++]);
+	needle = ((char **)arg->v)[i + 1] ? ((char **)arg->v)[i + 1] : ((char **)arg->v)[0];
+
+	wl_list_for_each(c, &clients, link)
+		if (strstr(client_get_title(c), needle)
+				|| strstr(client_get_appid(c), needle)) {
+			selmon = c->mon;
+			if (!(c->tags & selmon->tagset[selmon->seltags]))
+				selmon->tagset[selmon->seltags] = c->tags;
+
+			focusclient(c, 1);
+			arrange(selmon);
+			return;
+		}
+
+	spawn(arg);
+}
+
 void
 startdrag(struct wl_listener *listener, void *data)
 {
-- 
