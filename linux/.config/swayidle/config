# swayidle — idle, lock and suspend handling. Started from mango's exec-once.
#
# `-w` means swayidle waits for each command to finish. Two consequences that
# have both bitten this config: nothing here may block (a daemon in a handler
# wedges the whole chain), and before-sleep genuinely delays the suspend until
# the locker is up, which is what you want.
#
# The locker is swaylock, not gtklock. gtklock was a GTK app that coat could only
# theme by owning its whole config file; swaylock is one binary, reads
# ~/.config/swaylock/config, and is in both Arch's repos and OpenBSD ports, which
# gtklock is not.
#
# The `pgrep` guard replaces gtklock-once's single-instance check: the
# session-lock protocol allows exactly one lock client, so a second swaylock
# would fail, and without the guard a manual lock plus an idle lock used to
# produce two password prompts.

timeout 300 'pgrep -x swaylock >/dev/null || swaylock -f'

# wlopm, not `swaymsg output * dpms`. That line was carried over from sway and
# was dead for weeks under dwl -- swaymsg needs a sway IPC socket, finds none,
# exits non-zero, and the screen simply never blanked.
timeout 600 'wlopm --off "*"' resume 'wlopm --on "*"'

before-sleep 'pgrep -x swaylock >/dev/null || swaylock -f'

# THE LID FIX. `resume` above only runs as the 600s timeout's own handler, so
# coming back from a suspend left the outputs powered off: the machine woke, the
# panel stayed black, and it took another keypress and about ten seconds before
# anything tripped the idle-resume path. Pressing the power button repeatedly was
# not waking it up -- it was already awake with the backlight off.
#
# after-resume runs unconditionally on wake, so the outputs come back every time.
after-resume 'wlopm --on "*"'

# NOT ww-restore. That was for ww, the old wallpaper daemon, which could not
# survive its output being destroyed. swaybg is the wallpaper now and handles
# hotplug itself, and leaving the old handler in place meant every resume started
# a second wallpaper daemon on top of swaybg.
