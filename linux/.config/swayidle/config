# swayidle — started from sway's config with `-w` (wait for each command to
# finish before moving on).
#
# Every lock goes through `gtklock-once`, never bare `gtklock`: it adds -d
# (detach — gtklock's -f is --follow-focus, not fork) and refuses to stack a
# second lock surface. Both matter, see the comments in that script. Calling the
# locker directly here is what caused the double password prompt after a lid
# close/open cycle.
timeout 300 'gtklock-once'
timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"'
before-sleep 'gtklock-once'
