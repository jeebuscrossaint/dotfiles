# swayidle — idle, lock and suspend handling. Started from mango's exec-once.
#
# `-w` waits for each command to finish: nothing here may block (a daemon in a
# handler wedges the chain), and before-sleep genuinely delays suspend until the
# locker is up.
#
# The pgrep guard is not optional -- session-lock allows exactly one lock client,
# so a manual lock plus an idle lock gave two password prompts.
timeout 300 'pgrep -x swaylock >/dev/null || swaylock -f'

# wlopm, not `swaymsg output * dpms`: swaymsg needs a sway IPC socket, finds none
# under mango, and the screen simply never blanked.
timeout 600 'wlopm --off "*"' resume 'wlopm --on "*"'

before-sleep 'pgrep -x swaylock >/dev/null || swaylock -f'

# `resume` above only fires as the 600s timeout's own handler, so waking from
# suspend left the panel powered off -- awake, backlight dark, looking dead.
# after-resume runs unconditionally.
after-resume 'wlopm --on "*"'
