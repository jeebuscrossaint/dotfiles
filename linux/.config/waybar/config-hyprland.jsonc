// waybar under Hyprland. An OVERLAY on config.jsonc, not a copy: only modules-left
// differs. The shared config's left side is custom/mangotags + custom/mangotitle,
// which stream mango's IPC and come up empty here; the reverse -- hyprland/* in the
// shared config -- throws "Hyprland is not running" on every mango login.
//
// The outer definition wins on any key it defines, so everything else (right side,
// geometry, style.css) comes from the include.
//
// Started from hyprland.conf: exec-once = waybar -c <this file>
{
  "include": ["/home/amarnath/.config/waybar/config.jsonc"],

  // One island, not two. hyprland/window does NOT hide itself when there is no
  // focused window (waybar 0.15 sets `floating` and `solo` classes but no `empty`
  // one to hook), so as its own island it rendered a bare rounded blob on any
  // empty workspace. Sharing the tags' island means an empty title collapses into
  // it instead -- see the padding note in style.css.
  "modules-left": ["group/left"],

  "group/left": {
    "orientation": "horizontal",
    "modules": ["hyprland/workspaces", "hyprland/window"]
  },

  // No persistent-workspaces: Hyprland destroys a workspace with its last window,
  // so the row already shows only occupied-or-active ones, like mango's tag row.
  "hyprland/workspaces": {
    "format": "{id}",
    "sort-by": "id",
    // Per-output, unlike mango-tags, which has no way to know which bar it is on.
    "all-outputs": false,
    "active-only": false,
    "show-special": true,
    "on-click": "activate",
    "on-scroll-up": "e+1",
    "on-scroll-down": "e-1"
  },

  // NOT wlr/taskbar: that renders a button per toplevel and max-length applies per
  // button, so six windows shoved the clock off the edge.
  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true,
    "icon": false,
    // Regex, so each offender needs its own line.
    //
    // Every replacement ends in ONE literal space, so the title never sits flush
    // against the island's right edge. It has to go here and not in `format` or as
    // CSS padding: both of those would apply to an EMPTY title too, giving it a
    // non-zero width and putting the bare slab back on empty workspaces. `^$`
    // stays empty for exactly that reason, and the `(.+)` catch-all only matches
    // when there is at least one character.
    "rewrite": {
      "(.*) — Mozilla Firefox": "$1 ",
      "(.*) - Visual Studio Code": "$1 ",
      "(.*) — Vesktop": "$1 ",
      "^$": "",
      "(.+)": "$1 "
    }
  }
}
