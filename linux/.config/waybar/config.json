{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "fixed-center": true,

    "modules-left": ["hyprland/workspaces", "hyprland/window", "hyprland/submap", "custom/weather", "custom/canvas"],
    "modules-center": [],
    "modules-right": ["custom/network", "custom/bluetooth", "custom/updates", "cpu", "custom/temp", "memory", "disk", "custom/power", "custom/battery", "custom/coat", "idle_inhibitor", "custom/notifications", "tray", "clock"],

    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true
    },

    "hyprland/submap": {
        "format": "  {}",
        "tooltip": false
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰛊" },
        "tooltip-format-activated": "Idle inhibited (caffeine on)",
        "tooltip-format-deactivated": "Idle allowed"
    },

    "custom/power": {
        "exec": "waybar-power",
        "return-type": "json",
        "interval": 5
    },

    "custom/updates": {
        "exec": "waybar-updates",
        "return-type": "json",
        "interval": 3600,
        "on-click": "kitty -e paru -Syu"
    },

    "disk": {
        "interval": 60,
        "path": "/",
        "format": "󰋊",
        "tooltip-format": "Disk: {used} / {total} used ({percentage_used}%)"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/coat": {
        "exec": "waybar-coat",
        "return-type": "json",
        "interval": 5,
        "on-click": "waybar-coat menu",
        "on-click-right": "waybar-coat random"
    },

    "custom/notifications": {
        "exec": "waybar-notifications",
        "return-type": "json",
        "interval": 2,
        "on-click": "dunstctl set-paused toggle",
        "on-click-right": "dunstctl history-pop",
        "on-click-middle": "dunstctl close-all"
    },

    "clock": {
        "interval": 10,
        "format": "{:%a %b %e  %I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<b>{}</b>",
                "days": "<b>{}</b>",
                "weeks": "<b>W{}</b>",
                "weekdays": "<b>{}</b>",
                "today": "<b><u>{}</u></b>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 300,
        "exec": "wttrbar --fahrenheit --mph --nerd --custom-indicator '{ICON}'",
        "return-type": "json"
    },

    "custom/network": {
        "exec": "waybar-network",
        "return-type": "json",
        "interval": 10,
        "on-click": "sh -c 'command -v nm-connection-editor && nm-connection-editor'"
    },

    "custom/bluetooth": {
        "exec": "waybar-bluetooth",
        "return-type": "json",
        "interval": 10,
        "on-click": "sh -c 'command -v blueman-manager && blueman-manager'"
    },

    "cpu": {
        "interval": 5,
        "format": "󰻠",
        "tooltip-format": "CPU: {usage}%\nLoad: {load}"
    },

    "custom/temp": {
        "exec": "waybar-temp",
        "interval": 5,
        "format": ""
    },

    "memory": {
        "interval": 10,
        "format": "󰍛",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G"
    },

    "custom/battery": {
        "exec": "waybar-battery",
        "return-type": "json",
        "interval": 30
    },

    "custom/canvas": {
        "exec": "waybar-canvas",
        "return-type": "json",
        "interval": 300
    }
}
