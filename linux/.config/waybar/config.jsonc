// waybar — the bar, replacing swaybar+swayrbar (sway) and dwl's built-in bar.
//
// waybar is the compromise in this stack: it is C++/GTK3 and the least minimal
// thing here. It is also the ONLY bar present in both Arch's repos and OpenBSD
// ports -- yambar is in neither tree for OpenBSD, and dwlb/somebar are
// dwl-specific. So this is the price of a bar that runs on both machines.
//
// The status line is deliberately ONE module: slstatus, already vendored in
// pkg/slstatus and already producing exactly the fields you want (wifi, cpu,
// mem, load, disk, temp, fan, backlight, volume, battery, uptime, clock) via its
// own C readers plus the barstat script. `slstatus -s` streams one line per
// second on stdout, which is precisely what a waybar custom module in continuous
// mode consumes -- so the entire status side needs no waybar configuration at
// all, and it stays identical to what the dwl bar showed. slstatus builds on
// OpenBSD too, which is the other reason to keep it rather than reimplement a
// dozen waybar modules.
//
// NOTE: waybar has NO mango module. mango is dwl-derived but does not implement
// dwl's IPC protocol -- its protocols/ dir carries only layer-shell,
// foreign-toplevel and output-power-management -- so `dwl/tags` cannot see it
// either. Tags therefore come from mango's own IPC through the mango-tags
// script, which streams `mmsg watch all-tags`. The window title comes from
// wlr/taskbar's protocol instead, which mango DOES implement.
{
  "layer": "top",
  "position": "bottom",
  "height": 22,
  "spacing": 0,
  "margin": "0",

  "modules-left": ["custom/mangotags", "wlr/taskbar"],
  "modules-center": [],
  "modules-right": ["custom/slstatus"],

  "custom/mangotags": {
    "exec": "mango-tags",
    // No interval: mango-tags blocks on mmsg and emits a line per state change,
    // so the bar updates the instant a tag does rather than up to a second late.
    "return-type": "",
    "restart-interval": 5,
    "escape": false,
    "tooltip": false
  },

  "wlr/taskbar": {
    // wlr-foreign-toplevel-management is in mango's protocols/, so this works
    // where a mango-specific title module would not. Text only -- icons would
    // pull in a theme lookup for no benefit at 22px.
    "format": "{title}",
    "icon-size": 0,
    // 24, not 80. slstatus emits ~270 characters, which at 10pt MartianMono is
    // already ~2030px of a 2560px panel. An 80-char title pushed the total past
    // the output width and GTK shoved the right-hand end -- the clock -- off the
    // screen. 24 leaves comfortable headroom without truncating anything useful,
    // and the full title is in the tooltip.
    "max-length": 24,
    "tooltip": true,
    "on-click": "activate"
  },

  "custom/slstatus": {
    "exec": "slstatus -s",
    // No interval: slstatus emits a line per second and waybar renders each one
    // as it arrives. restart-interval brings it back if it ever dies.
    "restart-interval": 5,
    "escape": true,
    "tooltip": false
  }
}
