// waybar — the bar. Native modules only.
//
// This replaced a three-layer chain that rendered the status line:
//
//   waybar -> slstatus (vendored C, needed `make install`) -> barstat (shell,
//   4 forks/sec) -> /sys/*
//
// slstatus was inherited from the swaybar/swayrbar era, where a bar that read a
// text stream was the only option. It survived here on the claim that it "works
// on OpenBSD", which was false in practice: 10 of the 15 fields came from
// barstat, a shell script reading /sys/class/power_supply, /sys/class/hwmon,
// /sys/class/backlight and /sys/class/net -- none of which exist there. So the
// portability argument for keeping it was backwards.
//
// Everything below is a waybar module, which means one project's portability to
// worry about instead of a shell script full of Linux paths, per-field CSS
// (battery can go red at 10%; a single text blob cannot), and pkg/ deleted.
//
// Fan and uptime are the two fields waybar has no module for. Both resolve their
// hardware by NAME rather than hwmon index, because hwmon numbering is not stable
// across boots -- coretemp happened to be hwmon7 today.
[
{
  "layer": "top",
  "position": "top",
  // 30 and floating, not 22 flush. The bar is inset from the edges and the visible slabs
  // are drawn per module-group in the CSS, so it reads as pills over the wallpaper rather
  // than one bar welded to the top of the screen. mango's blur_layer frosts them.
  "height": 30,
  "spacing": 4,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,

  // mango is the only compositor now, so these two are the whole left side. Both
  // stream mango's IPC; see the mango block below.
  "modules-left": ["custom/mangotags", "custom/mangotitle"],
  "modules-center": [],
  "modules-right": [
    "mpris",
    "network",
    "disk",
    "cpu",
    "memory",
    "temperature",
    "custom/fan",
    "backlight",
    "wireplumber",
    "battery",
    "custom/uptime",
    "clock"
  ],

  // ── mango ────────────────────────────────────────────────────────────────
  // waybar has no mango module, and mango does not implement dwl's IPC protocol
  // (protocols/ has only layer-shell, foreign-toplevel and
  // output-power-management), so `dwl/tags` cannot see it either. Both of these
  // stream mango's own IPC via `mmsg watch`, which pushes on change rather than
  // polling, and emit pango markup because CSS cannot reach individual characters
  // inside a custom module.
  "custom/mangotags": {
    "exec": "mango-tags",
    "return-type": "",
    "restart-interval": 5,
    "escape": false,
    "tooltip": false
  },

  "custom/mangotitle": {
    "exec": "mango-title",
    "return-type": "",
    "restart-interval": 5,
    "escape": false,
    "tooltip": false
  },

  // ── status ───────────────────────────────────────────────────────────────
  "mpris": {
    "format": "{status_icon} {dynamic}",
    "dynamic-len": 38,
    "dynamic-order": ["artist", "title"],
    "status-icons": { "playing": "󰐊", "paused": "󰏤", "stopped": "󰓛" },
    "tooltip": false,
    "on-click": "osd playpause"
  },

  "network": {
    "interface": "wlan0",
    "format-wifi": "󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}  󰖩 {essid} {signalStrength}%",
    "format-ethernet": "󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}  󰈀 {ipaddr}",
    "format-disconnected": "󰖪 offline",
    "interval": 2,
    "tooltip": false,
    "on-click": "foot -e nmtui"
  },

  "disk": {
    "format": "󰋊 {percentage_used}% {free}",
    "path": "/",
    "interval": 30,
    "tooltip": false
  },

  "cpu": {
    // {load} is the 1-minute average, which is what the old load field showed.
    "format": "󰻠 {usage}%  󰬺 {load}",
    "interval": 2,
    "tooltip": false,
    "on-click": "foot -e btop"
  },

  "memory": {
    "format": "󰍛 {percentage}%",
    "format-swap": "󰾵 {swapPercentage}%",
    "interval": 5,
    "tooltip": false,
    "on-click": "foot -e btop"
  },

  "temperature": {
    // hwmon-path-abs is the platform device path, which IS stable across boots;
    // the hwmonN directory beneath it is not, and waybar resolves that itself.
    // temp10_input is coretemp's package sensor on this Meteor Lake part.
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp10_input",
    "format": "󰔏 {temperatureC}°",
    "critical-threshold": 90,
    "format-critical": "󰸁 {temperatureC}°",
    "interval": 5,
    "tooltip": false
  },

  "custom/fan": {
    "exec": "waybar-fan",
    "interval": 5,
    "tooltip": false
  },

  "backlight": {
    // intel_backlight, not nvidia_0: the OLED panel is driven by the Intel card.
    "device": "intel_backlight",
    "format": "󰃠 {percent}%",
    "tooltip": false,
    "on-scroll-up": "osd brightness up",
    "on-scroll-down": "osd brightness down"
  },

  "wireplumber": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰝟 muted",
    "max-volume": 150,
    "tooltip": false,
    "on-click": "osd volume mute",
    "on-scroll-up": "osd volume up",
    "on-scroll-down": "osd volume down"
  },

  "battery": {
    "bat": "BAT1",
    "adapter": "ACAD",
    // These drive the CSS states, which is the thing a single text blob could
    // never do: the module goes amber at 25% and red at 10%.
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}% {power:.1f}W {time}",
    "format-charging": "󰂄 {capacity}% {power:.1f}W {time}",
    "format-full": "󰁹 {capacity}%",
    "format-time": "{H}h{m}m",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "interval": 10,
    "tooltip": false
  },

  "custom/uptime": {
    "exec": "waybar-uptime",
    "interval": 60,
    "tooltip": false
  },

  "clock": {
    // 1s because the old field showed ticking seconds.
    //
    // %d and %I, NOT %-d and %-I. waybar's clock formats through fmt/chrono,
    // which rejects glibc's no-pad modifier with "invalid specifier in
    // chrono-specs" -- and the failure mode is the whole module rendering
    // nothing, so the clock silently disappears off the end of the bar. %e and
    // %l (space-padded) are rejected too; zero-padded is what works.
    "format": "󰃰 {:%a %b %d  %I:%M:%S %p}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#20bcfc'><b>{}</b></span>",
        "today": "<span color='#fd886b'><b>{}</b></span>"
      }
    }
  }
}
,
// ═══════════════════════════════════════════════════════════════════════════
// THE DOCK — a second bar, not a second waybar.
//
// waybar takes an ARRAY of bar objects in one config, so this is one process with two
// surfaces. Two `waybar -c` instances would mean two GTK startups, two sets of module
// children to reap, and the SIGUSR1 bar-toggle bind hitting both.
//
// There is no dock in OpenBSD's wayland ports — none at all — so this is the portable
// way to get one. wlr/taskbar gives one button per open window, which is exactly what a
// dock is, and mango implements wlr-foreign-toplevel so it can see them.
//
// It is a LAYER-SHELL surface, so mango's blur_layer=1 frosts it. That is why its
// background is deliberately translucent: blur only shows through something you can see
// through.
{
  "name": "dock",
  "layer": "top",
  "position": "bottom",
  // 64, not 56: icon-size 40 plus padding needs 64 and waybar silently overrode
  // the smaller value ("Requested height: 56 is less than the minimum height: 64").
  "height": 64,
  "spacing": 0,
  // The BAR spans the whole output — a layer-shell surface always does and waybar has
  // no shrink-to-fit. The island look comes from the CSS: the window is transparent and
  // the rounded frosted slab is drawn on the inner #taskbar container, which is only as
  // wide as its icons.
  "margin-bottom": 8,
  "modules-left": [],
  "modules-center": ["wlr/taskbar"],
  "modules-right": [],

  "wlr/taskbar": {
    // Icon only. A dock with text labels is a taskbar, which is the Windows idea.
    "format": "{icon}",
    "icon-size": 40,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "all-outputs": false,
    // Nothing to hide yet; add app-ids here if something clutters it.
    "ignore-list": []
  }
}
]
