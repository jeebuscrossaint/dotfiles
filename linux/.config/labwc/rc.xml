<?xml version="1.0"?>
<!--
  labwc 0.20. Every key is listed; booleans take yes|no.
  Theme name and fonts come from coat (`coat docs labwc`); setting them here
  overrides coat. Start with:
    XDG_CONFIG_DIRS=$HOME/.local/share/coat/labwc:/etc/xdg labwc -m
-->
<labwc_config>

  <core>
    <decoration>server</decoration>  <!-- server|client -->
    <gap>10</gap>
    <adaptiveSync>no</adaptiveSync>  <!-- yes|no|fullscreen -->
    <allowTearing>no</allowTearing>  <!-- yes|no|fullscreen|fullscreenForced -->
    <autoEnableOutputs>yes</autoEnableOutputs>
    <hdr>no</hdr>
    <reuseOutputMode>no</reuseOutputMode>
    <xwaylandPersistence>no</xwaylandPersistence>
    <primarySelection>yes</primarySelection>
    <promptCommand>labnag --message '%m' --button-dismiss '%n' --button-dismiss '%y' --background-color '%b' --text-color '%t' --button-border-color '%t' --border-bottom-color '%t' --button-background-color '%b' --button-text-color '%t' --border-bottom-size 1 --button-border-size 3 --keyboard-focus on-demand --layer overlay --timeout 0</promptCommand>
    <errorCommand>labnag --message 'Config errors detected' --button-dismiss 'Close' --layer overlay --timeout 0 --detailed-message</errorCommand>
  </core>

  <placement>
    <policy>cascade</policy>  <!-- center|automatic|cursor|cascade -->
    <cascadeOffset x="40" y="30" />
  </placement>

  <theme>
    <!-- <name>coat</name>  set by coat -->
    <icon>WhiteSur-dark</icon>
    <fallbackAppIcon>application-x-executable</fallbackAppIcon>
    <titlebar>
      <!-- traffic lights on the left, nothing on the right -->
      <layout>close,iconify,max:</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>10</cornerRadius>
    <keepBorder>yes</keepBorder>
    <maximizedDecoration>titlebar</maximizedDecoration>  <!-- titlebar|none -->
    <dropShadows>yes</dropShadows>
    <dropShadowsOnTiled>no</dropShadowsOnTiled>
    <!-- <font place="ActiveWindow|InactiveWindow|MenuHeader|MenuItem|OnScreenDisplay">  set by coat -->
  </theme>

  <!-- Cmd-Tab: big tiles, app name under each, no outline drawn on the desktop -->
  <windowSwitcher preview="yes" outlines="no" unshade="yes" order="focus">
    <osd show="yes" style="thumbnail" output="focused" thumbnailLabelFormat="%n" />
    <fields>
      <field content="icon" width="5%" />
      <field content="desktop_entry_name" width="30%" />
      <field content="title" width="65%" />
    </fields>
  </windowSwitcher>

  <resistance>
    <screenEdgeStrength>20</screenEdgeStrength>
    <windowEdgeStrength>20</windowEdgeStrength>
    <unSnapThreshold>20</unSnapThreshold>
    <unMaximizeThreshold>150</unMaximizeThreshold>
  </resistance>

  <resize>
    <popupShow>Never</popupShow>  <!-- Never|Always|Nonpixel -->
    <drawContents>yes</drawContents>
    <cornerRange>12</cornerRange>
    <minimumArea>8</minimumArea>
  </resize>

  <!-- macOS: click to focus, focus raises -->
  <focus>
    <followMouse>no</followMouse>
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <raiseOnFocus>no</raiseOnFocus>
    <raiseOnFocusDelay>0</raiseOnFocusDelay>
  </focus>

  <snapping>
    <range inner="10" outer="10" />
    <cornerRange>50</cornerRange>
    <overlay enabled="yes">
      <delay inner="300" outer="300" />
    </overlay>
    <topMaximize>yes</topMaximize>
    <notifyClient>always</notifyClient>  <!-- always|region|edge|never -->
  </snapping>

  <regions>
    <region name="top-left"     x="0%"  y="0%"  height="50%"  width="50%"  />
    <region name="top"          x="0%"  y="0%"  height="50%"  width="100%" />
    <region name="top-right"    x="50%" y="0%"  height="50%"  width="50%"  />
    <region name="left"         x="0%"  y="0%"  height="100%" width="50%"  />
    <region name="center"       x="10%" y="10%" height="80%"  width="80%"  />
    <region name="right"        x="50%" y="0%"  height="100%" width="50%"  />
    <region name="bottom-left"  x="0%"  y="50%" height="50%"  width="50%"  />
    <region name="bottom"       x="0%"  y="50%" height="50%"  width="100%" />
    <region name="bottom-right" x="50%" y="50%" height="50%"  width="50%"  />
  </regions>

  <desktops>
    <popupTime>500</popupTime>
    <initial>1</initial>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
      <name>5</name>
      <name>6</name>
      <name>7</name>
      <name>8</name>
      <name>9</name>
      <name>10</name>
    </names>
  </desktops>

  <margin top="0" bottom="0" left="0" right="0" />

  <!-- W super, A alt, C ctrl, S shift -->
  <keyboard>
    <numlock>off</numlock>
    <layoutScope>global</layoutScope>  <!-- global|window -->
    <repeatRate>50</repeatRate>
    <repeatDelay>200</repeatDelay>

    <!-- apps -->
    <keybind key="W-q"><action name="Execute" command="kitty" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="kitty" /></keybind>
    <keybind key="W-S-b"><action name="Execute" command="helium-browser" /></keybind>
    <keybind key="W-d"><action name="Execute" command="fuzzel" /></keybind>
    <!-- Spotlight -->
    <keybind key="W-space"><action name="Execute" command="fuzzel" /></keybind>
    <keybind key="W-v">
      <action name="Execute">
        <command>sh -c 'cliphist list | fuzzel --dmenu --prompt "clip " | cliphist decode | wl-copy'</command>
      </action>
    </keybind>
    <keybind key="W-s"><action name="ShowMenu" menu="client-list-combined-menu" /></keybind>
    <keybind key="W-S-p"><action name="Execute" command="hyprpicker -a -n -r" /></keybind>

    <!-- screenshots -->
    <keybind key="W-S-s">
      <action name="Execute">
        <command>sh -c 'mkdir -p ~/Pictures/Screenshots; f=~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png; grim -g "$(slurp)" "$f" &amp;&amp; wl-copy &lt; "$f"'</command>
      </action>
    </keybind>
    <keybind key="W-S-e">
      <action name="Execute">
        <command>sh -c 'mkdir -p ~/Pictures/Screenshots; grim -g "$(slurp)" - | satty --filename - --output-filename "~/Pictures/Screenshots/%Y%m%d_%H%M%S.png" --copy-command wl-copy --early-exit'</command>
      </action>
    </keybind>

    <!-- theme -->
    <keybind key="W-t">
      <action name="Execute">
        <command>sh -c 's=$(coat list --no-preview | awk "/Slug:/{print \$2}" | sort -u | fuzzel --dmenu --prompt "theme ") &amp;&amp; coat set "$s" >/dev/null 2>&amp;1 &amp;&amp; notify-send -t 2000 "󰏘  Theme" "switched to $s"'</command>
      </action>
    </keybind>
    <keybind key="W-S-t">
      <action name="Execute">
        <command>sh -c 'coat random -y >/dev/null 2>&amp;1; notify-send -t 2000 "󰏘  Theme" "switched to $(awk "\$1==\"scheme:\"{print \$2}" ~/.local/state/coat/state.yaml)"'</command>
      </action>
    </keybind>
    <keybind key="W-A-t"><action name="Execute" command="coat match" /></keybind>

    <!-- session; Ctrl-Cmd-Q locks on macOS -->
    <keybind key="W-l"><action name="Execute" command="sh -c 'pidof hyprlock || hyprlock'" /></keybind>
    <keybind key="W-Escape"><action name="Execute" command="sh -c 'pidof hyprlock || hyprlock'" /></keybind>
    <keybind key="W-C-q"><action name="Execute" command="sh -c 'pidof hyprlock || hyprlock'" /></keybind>
    <keybind key="W-p">
      <action name="Execute">
        <command>sh -c 'if [ -e ~/.cache/conky.off ]; then rm -f ~/.cache/conky.off; else touch ~/.cache/conky.off; pkill -x conky; fi'</command>
      </action>
    </keybind>
    <keybind key="W-S-c"><action name="Reconfigure" /></keybind>
    <keybind key="W-S-q"><action name="Exit" /></keybind>
    <keybind key="W-z"><action name="Execute" command="sh -c 'pidof woomer || woomer'" /></keybind>
    <keybind key="W-A-n"><action name="Execute" command="osd nightlight" /></keybind>
    <keybind key="W-A-bracketleft"><action name="Execute" command="osd nightlight warmer" /></keybind>
    <keybind key="W-A-bracketright"><action name="Execute" command="osd nightlight cooler" /></keybind>
    <keybind key="XF86Launch1"><action name="Execute" command="rog-control-center" /></keybind>

    <!-- windows -->
    <keybind key="W-c"><action name="Close" /></keybind>
    <keybind key="W-w"><action name="Close" /></keybind>
    <keybind key="W-S-x"><action name="Kill" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <!-- Cmd-M / Cmd-H -->
    <keybind key="W-m"><action name="Iconify" /></keybind>
    <keybind key="W-h"><action name="Iconify" /></keybind>
    <keybind key="W-minus"><action name="Iconify" /></keybind>
    <keybind key="W-S-minus"><action name="ShowMenu" menu="client-list-combined-menu" /></keybind>
    <keybind key="W-f"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-S-f"><action name="ToggleFullscreen" /></keybind>
    <!-- Ctrl-Cmd-F -->
    <keybind key="W-C-f"><action name="ToggleFullscreen" /></keybind>
    <keybind key="W-y"><action name="ToggleAlwaysOnTop" /></keybind>
    <keybind key="W-S-o">
      <action name="AutoPlace" policy="center" />
    </keybind>
    <keybind key="W-S-d"><action name="ToggleDecorations" /></keybind>
    <keybind key="W-grave"><action name="ToggleOmnipresent" /></keybind>
    <keybind key="A-space"><action name="ShowMenu" menu="client-menu" atCursor="no" /></keybind>
    <keybind key="W-k"><action name="PreviousWindow" /></keybind>
    <keybind key="W-S-z"><action name="ToggleMagnify" /></keybind>
    <keybind key="W-equal"><action name="ZoomIn" /></keybind>
    <keybind key="W-S-equal"><action name="ZoomOut" /></keybind>

    <!-- Cmd-Tab and Alt-Tab -->
    <keybind key="W-Tab"><action name="NextWindow" /></keybind>
    <keybind key="W-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="W-j"><action name="NextWindow" /></keybind>

    <!-- tiling: halves on arrows (Sequoia's Fn-Ctrl-arrows), quarters on the numpad -->
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" combine="yes" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" combine="yes" /></keybind>
    <keybind key="W-Up"><action name="SnapToEdge" direction="up" combine="yes" /></keybind>
    <keybind key="W-Down"><action name="SnapToEdge" direction="down" combine="yes" /></keybind>
    <keybind key="W-S-Left"><action name="MoveToEdge" direction="left" snapWindows="yes" /></keybind>
    <keybind key="W-S-Right"><action name="MoveToEdge" direction="right" snapWindows="yes" /></keybind>
    <keybind key="W-S-Up"><action name="MoveToEdge" direction="up" snapWindows="yes" /></keybind>
    <keybind key="W-S-Down"><action name="MoveToEdge" direction="down" snapWindows="yes" /></keybind>
    <keybind key="W-C-Left"><action name="MoveRelative" x="-40" y="0" /></keybind>
    <keybind key="W-C-Right"><action name="MoveRelative" x="40" y="0" /></keybind>
    <keybind key="W-C-Up"><action name="MoveRelative" x="0" y="-40" /></keybind>
    <keybind key="W-C-Down"><action name="MoveRelative" x="0" y="40" /></keybind>
    <keybind key="W-C-S-Left"><action name="ResizeRelative" left="0" right="-40" top="0" bottom="0" /></keybind>
    <keybind key="W-C-S-Right"><action name="ResizeRelative" left="0" right="40" top="0" bottom="0" /></keybind>
    <keybind key="W-C-S-Up"><action name="ResizeRelative" left="0" right="0" top="0" bottom="-40" /></keybind>
    <keybind key="W-C-S-Down"><action name="ResizeRelative" left="0" right="0" top="0" bottom="40" /></keybind>
    <keybind key="W-KP_7"><action name="SnapToRegion" region="top-left" /></keybind>
    <keybind key="W-KP_8"><action name="SnapToRegion" region="top" /></keybind>
    <keybind key="W-KP_9"><action name="SnapToRegion" region="top-right" /></keybind>
    <keybind key="W-KP_4"><action name="SnapToRegion" region="left" /></keybind>
    <keybind key="W-KP_5"><action name="SnapToRegion" region="center" /></keybind>
    <keybind key="W-KP_6"><action name="SnapToRegion" region="right" /></keybind>
    <keybind key="W-KP_1"><action name="SnapToRegion" region="bottom-left" /></keybind>
    <keybind key="W-KP_2"><action name="SnapToRegion" region="bottom" /></keybind>
    <keybind key="W-KP_3"><action name="SnapToRegion" region="bottom-right" /></keybind>
    <keybind key="W-r"><action name="Resize" /></keybind>

    <!-- desktops: W-N go, W-S-N send, W-C-N send and follow -->
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-5"><action name="GoToDesktop" to="5" /></keybind>
    <keybind key="W-6"><action name="GoToDesktop" to="6" /></keybind>
    <keybind key="W-7"><action name="GoToDesktop" to="7" /></keybind>
    <keybind key="W-8"><action name="GoToDesktop" to="8" /></keybind>
    <keybind key="W-9"><action name="GoToDesktop" to="9" /></keybind>
    <keybind key="W-0"><action name="GoToDesktop" to="10" /></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="no" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="no" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="no" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" follow="no" /></keybind>
    <keybind key="W-S-5"><action name="SendToDesktop" to="5" follow="no" /></keybind>
    <keybind key="W-S-6"><action name="SendToDesktop" to="6" follow="no" /></keybind>
    <keybind key="W-S-7"><action name="SendToDesktop" to="7" follow="no" /></keybind>
    <keybind key="W-S-8"><action name="SendToDesktop" to="8" follow="no" /></keybind>
    <keybind key="W-S-9"><action name="SendToDesktop" to="9" follow="no" /></keybind>
    <keybind key="W-S-0"><action name="SendToDesktop" to="10" follow="no" /></keybind>
    <keybind key="W-C-1"><action name="SendToDesktop" to="1" /></keybind>
    <keybind key="W-C-2"><action name="SendToDesktop" to="2" /></keybind>
    <keybind key="W-C-3"><action name="SendToDesktop" to="3" /></keybind>
    <keybind key="W-C-4"><action name="SendToDesktop" to="4" /></keybind>
    <keybind key="W-C-5"><action name="SendToDesktop" to="5" /></keybind>
    <keybind key="W-C-6"><action name="SendToDesktop" to="6" /></keybind>
    <keybind key="W-C-7"><action name="SendToDesktop" to="7" /></keybind>
    <keybind key="W-C-8"><action name="SendToDesktop" to="8" /></keybind>
    <keybind key="W-C-9"><action name="SendToDesktop" to="9" /></keybind>
    <keybind key="W-C-0"><action name="SendToDesktop" to="10" /></keybind>
    <keybind key="W-A-Left"><action name="GoToDesktop" to="left" wrap="no" /></keybind>
    <keybind key="W-A-Right"><action name="GoToDesktop" to="right" wrap="no" /></keybind>
    <keybind key="W-A-S-Left"><action name="SendToDesktop" to="left" wrap="no" /></keybind>
    <keybind key="W-A-S-Right"><action name="SendToDesktop" to="right" wrap="no" /></keybind>
    <keybind key="W-comma"><action name="FocusOutput" direction="left" /></keybind>
    <keybind key="W-period"><action name="FocusOutput" direction="right" /></keybind>
    <keybind key="W-S-comma"><action name="MoveToOutput" direction="left" /></keybind>
    <keybind key="W-S-period"><action name="MoveToOutput" direction="right" /></keybind>

    <!-- media, through the osd script; work on the lock screen too -->
    <keybind key="XF86AudioRaiseVolume" allowWhenLocked="yes"><action name="Execute" command="osd volume up" /></keybind>
    <keybind key="XF86AudioLowerVolume" allowWhenLocked="yes"><action name="Execute" command="osd volume down" /></keybind>
    <keybind key="XF86AudioMute" allowWhenLocked="yes"><action name="Execute" command="osd volume mute" /></keybind>
    <keybind key="XF86AudioMicMute" allowWhenLocked="yes"><action name="Execute" command="osd mic mute" /></keybind>
    <keybind key="XF86AudioPlay" allowWhenLocked="yes"><action name="Execute" command="osd playpause" /></keybind>
    <keybind key="XF86AudioPause" allowWhenLocked="yes"><action name="Execute" command="osd playpause" /></keybind>
    <keybind key="XF86Launch3" allowWhenLocked="yes"><action name="Execute" command="osd playpause" /></keybind>
    <keybind key="XF86AudioNext" allowWhenLocked="yes"><action name="Execute" command="osd next" /></keybind>
    <keybind key="XF86AudioPrev" allowWhenLocked="yes"><action name="Execute" command="osd prev" /></keybind>
    <keybind key="XF86MonBrightnessUp" allowWhenLocked="yes"><action name="Execute" command="osd brightness up" /></keybind>
    <keybind key="XF86MonBrightnessDown" allowWhenLocked="yes"><action name="Execute" command="osd brightness down" /></keybind>
    <keybind key="XF86KbdBrightnessUp" allowWhenLocked="yes"><action name="Execute" command="osd kbd up" /></keybind>
    <keybind key="XF86KbdBrightnessDown" allowWhenLocked="yes"><action name="Execute" command="osd kbd down" /></keybind>
  </keyboard>

  <mouse>
    <doubleClickTime>400</doubleClickTime>

    <context name="Frame">
      <mousebind button="W-Left" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
      <mousebind button="W-Left" action="Drag"><action name="Move" /></mousebind>
      <mousebind button="W-Right" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
      <mousebind button="W-Right" action="Drag"><action name="Resize" /></mousebind>
      <mousebind button="W-Middle" action="Press"><action name="ToggleAlwaysOnTop" /></mousebind>
    </context>

    <context name="Border">
      <mousebind button="Left" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
      <mousebind button="Left" action="Drag"><action name="Resize" /></mousebind>
    </context>

    <!-- no roll-up on scroll: macOS has no shading -->
    <context name="TitleBar">
      <mousebind button="Left" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
      <mousebind button="Right" action="Click"><action name="Focus" /><action name="Raise" /></mousebind>
    </context>

    <!-- double-click the title to zoom -->
    <context name="Title">
      <mousebind button="Left" action="Drag"><action name="Move" /></mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize" /></mousebind>
      <mousebind button="Right" action="Click"><action name="ShowMenu" menu="client-menu" /></mousebind>
    </context>

    <context name="Maximize">
      <mousebind button="Left" action="Click"><action name="ToggleMaximize" /></mousebind>
      <mousebind button="Right" action="Click"><action name="ToggleMaximize" direction="horizontal" /></mousebind>
      <mousebind button="Middle" action="Click"><action name="ToggleMaximize" direction="vertical" /></mousebind>
    </context>

    <context name="WindowMenu">
      <mousebind button="Left" action="Click"><action name="ShowMenu" menu="client-menu" atCursor="no" /></mousebind>
      <mousebind button="Right" action="Click"><action name="ShowMenu" menu="client-menu" atCursor="no" /></mousebind>
    </context>

    <context name="Icon">
      <mousebind button="Left" action="Click"><action name="ShowMenu" menu="client-menu" atCursor="no" /></mousebind>
      <mousebind button="Right" action="Click"><action name="ShowMenu" menu="client-menu" atCursor="no" /></mousebind>
    </context>

    <context name="Shade">
      <mousebind button="Left" action="Click"><action name="ToggleShade" /></mousebind>
    </context>

    <context name="AllDesktops">
      <mousebind button="Left" action="Click"><action name="ToggleOmnipresent" /></mousebind>
    </context>

    <context name="Iconify">
      <mousebind button="Left" action="Click"><action name="Iconify" /></mousebind>
    </context>

    <context name="Close">
      <mousebind button="Left" action="Click"><action name="Close" /></mousebind>
    </context>

    <context name="Client">
      <mousebind button="Left" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
      <mousebind button="Middle" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
    </context>

    <!-- desktop: right-click menu only, as in Finder -->
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu" menu="root-menu" /></mousebind>
      <mousebind button="Middle" action="Press"><action name="ShowMenu" menu="client-list-combined-menu" /></mousebind>
      <mousebind direction="Up" action="Scroll"><action name="GoToDesktop" to="left" wrap="no" /></mousebind>
      <mousebind direction="Down" action="Scroll"><action name="GoToDesktop" to="right" wrap="no" /></mousebind>
    </context>
  </mouse>

  <touch>
    <!-- <deviceName></deviceName> -->
    <!-- <mapToOutput>eDP-1</mapToOutput> -->
    <mouseEmulation>no</mouseEmulation>
  </touch>

  <tablet rotate="0" mouseEmulation="no">
    <!-- <mapToOutput>eDP-1</mapToOutput> -->
    <area top="0.0" left="0.0" width="0.0" height="0.0" />
    <map button="Tip" to="Left" />
    <map button="Stylus" to="Right" />
    <map button="Stylus2" to="Middle" />
  </tablet>

  <tabletTool motion="absolute" relativeMotionSensitivity="1.0" minPressure="0.0" maxPressure="1.0" />

  <libinput>
    <!-- trackpad: natural scroll, tap, two-finger right click -->
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
      <leftHanded>no</leftHanded>
      <pointerSpeed>0.0</pointerSpeed>
      <accelProfile>adaptive</accelProfile>  <!-- flat|adaptive -->
      <tap>yes</tap>
      <tapButtonMap>lrm</tapButtonMap>  <!-- lrm|lmr -->
      <tapAndDrag>yes</tapAndDrag>
      <dragLock>no</dragLock>  <!-- yes|no|timeout -->
      <threeFingerDrag>yes</threeFingerDrag>  <!-- yes|no|3|4 -->
      <middleEmulation>no</middleEmulation>
      <disableWhileTyping>yes</disableWhileTyping>
      <clickMethod>clickfinger</clickMethod>  <!-- none|buttonAreas|clickfinger -->
      <scrollMethod>twofinger</scrollMethod>  <!-- none|twofinger|edge|onbutton -->
      <!-- <scrollButton>274</scrollButton> -->
      <sendEventsMode>yes</sendEventsMode>  <!-- yes|no|disabledOnExternalMouse -->
      <!-- <calibrationMatrix>1 0 0 0 1 0</calibrationMatrix> -->
      <scrollFactor>1.0</scrollFactor>
    </device>
    <device category="non-touch">
      <naturalScroll>no</naturalScroll>
      <leftHanded>no</leftHanded>
      <pointerSpeed>0.0</pointerSpeed>
      <accelProfile>flat</accelProfile>
      <middleEmulation>no</middleEmulation>
      <scrollMethod>none</scrollMethod>
      <sendEventsMode>yes</sendEventsMode>
      <scrollFactor>1.0</scrollFactor>
    </device>
    <device category="default">
      <tap>yes</tap>
      <scrollFactor>1.0</scrollFactor>
    </device>
  </libinput>

  <!--
    Criteria: identifier, title, type, sandboxEngine, sandboxAppId, matchOnce.
    Properties: serverDecoration, skipTaskbar, skipWindowSwitcher,
    ignoreFocusRequest, ignoreConfigureRequest, allowAlwaysOnTop,
    fixedPosition, iconPriority (yes|no|default; client|server).
  -->
  <windowRules>
