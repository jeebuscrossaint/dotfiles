<?xml version="1.0"?>
<!--
  labwc root menu — right-click the desktop.

  This is a labwc feature with no equivalent in mango or sway, and it earns its
  place here specifically because rc.xml sets <decoration>none</decoration>: with
  no titlebars there is no window menu and no close button, so this is the only
  mouse-reachable way to act on the session.

  The menu id "root-menu" is special: labwc looks for exactly that name for the
  desktop right-click. "client-menu" is the other reserved id (the per-window
  menu), and labwc provides a built-in one, so it is deliberately not overridden
  here.
-->
<openbox_menu>
  <menu id="root-menu" label="labwc">
    <item label="Terminal">
      <action name="Execute" command="foot"/>
    </item>
    <item label="Run…">
      <action name="Execute" command="menu-run"/>
    </item>
    <item label="Browser">
      <action name="Execute" command="firefox"/>
    </item>

    <separator/>

    <menu id="theme-menu" label="Theme">
      <item label="Pick a scheme…">
        <action name="Execute" command="theme-pick"/>
      </item>
      <item label="Random scheme">
        <action name="Execute" command="theme-random"/>
      </item>
    </menu>

    <menu id="screenshot-menu" label="Screenshot">
      <item label="Region to clipboard">
        <action name="Execute" command="swayscreenshot"/>
      </item>
      <item label="Region to annotator">
        <action name="Execute" command="swayscreenshot-edit"/>
      </item>
      <item label="Pick a colour">
        <action name="Execute" command="pickcolor"/>
      </item>
    </menu>

    <separator/>

    <item label="Toggle bar">
      <action name="Execute" command="pkill -SIGUSR1 -x waybar"/>
    </item>
    <item label="Reconfigure">
      <action name="Reconfigure"/>
    </item>

    <separator/>

    <item label="Lock">
      <action name="Execute" command="swaylock -f"/>
    </item>
    <item label="Exit labwc">
      <action name="Exit"/>
    </item>
  </menu>
</openbox_menu>
