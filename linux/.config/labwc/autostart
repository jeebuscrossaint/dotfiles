#!/bin/sh

eval $(dbus-launch --sh-syntax --exit-with-session)
dbus-update-activation-environment DBUS_SESSION_BUS_ADDRESS WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=labwc &
swayidle -w -C ~/.config/swayidle/config &
dunst &

# Clipboard history (cliphist) — watch both text and images; recall with W-v
wl-paste --type text --watch cliphist store &
wl-paste --type image --watch cliphist store &

command -v nm-applet && nm-applet &

start-polkit &
canvas-notify &

# `restart` is required: the bare launcher skips WirePlumber, which leaves audio
# looking alive with no sinks. Same reason sway.fish uses it.
artix-pipewire-launcher restart &
