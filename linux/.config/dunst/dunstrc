# ~/.config/dunst/dunstrc — the notification daemon for the mango session.
#
# dunst because it is the only notification daemon in BOTH Arch and OpenBSD
# (x11/dunst, layer-shell there too), and because coat can theme it without
# owning this file: drop-ins in dunstrc.d/ are applied after it, last one
# winning. mako has a real `include` and would otherwise fit better, but OpenBSD
# has no mako port.
#
# NO COLOURS AND NO FONT HERE — they are in dunstrc.d/50-coat.conf and would lose
# to it anyway. Your own overrides go in a later-sorting drop-in (99-mine.conf).
#
# ~/.config/dunst must stay a REAL directory with only this file symlinked, or
# stow folds it and coat writes the drop-in inside the repo.

[global]
    ### Geometry ###

    origin = top-right
    offset = (12, 12)

    # Between notifications, not around them. dunst only honours this on a
    # compositor that can do it, which mango can; where it cannot, it silently
    # falls back to separator_height.
    gap_size = 8

    # A pair, not a single number: (min, max). The floor stops a two-word popup
    # from being a sliver.
    width = (380, 560)
    height = (0, 600)

    padding = 10
    horizontal_padding = 14

    frame_width = 1
    # Matches mango's border_radius -- blur_layer=1 frosts this now, so a square
    # corner is a square corner cut out of the blur.
    corner_radius = 12

    ### Display ###

    # overlay, not top: the OSD has to be readable over a fullscreen window, which
    # a top-layer surface is not. Also dunst's default; stated because it is a
    # decision, not an accident.
    layer = overlay

    # pickcolor sends a pango <span background="#rrggbb"> to show the colour it
    # picked, which is the only way to put the colour itself on screen. `strip`
    # or `no` here turns that into either plain text or visible markup.
    markup = full
    format = "<b>%s</b>\n%b"

    # osd draws volume, brightness and the keyboard backlight by passing
    # -h int:value:N, and this is what turns that into a level meter.
    progress_bar = true

    max_icon_size = 48

    ### Misc ###

    # fuzzel, not dmenu: dmenu is X11 and is not installed. This is what
    # `dunstctl context` opens, so the packaged /usr/bin/dmenu default is a
    # feature that fails silently the first time you reach for it.
    dmenu = /usr/bin/fuzzel --dmenu --prompt "dunst: "
    browser = /usr/bin/xdg-open

# osd replaces its own popup rather than stacking, so a held volume key does not
# need a long life here. A caller asking for longer with -t gets it.
[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 5

# Never self-dismisses. battery-watch and audio-ensure both send critical, and
# both are things you want still on screen when you come back to the machine.
[urgency_critical]
    timeout = 0
