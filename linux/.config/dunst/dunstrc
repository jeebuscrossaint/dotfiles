# Dunst configuration — hand-maintained.
#
# coat no longer writes this file. It writes the drop-in
# dunstrc.d/50-coat.conf, which carries only colours + font and is applied on
# top of this one (drop-ins beat the base config, last in lexical order wins).
# So the colours below are inert defaults for a bare checkout; the live theme
# comes from the drop-in. Geometry, timeouts, icons, format, mouse actions and
# the dmenu/browser commands belong here.

[global]
    # Display
    monitor = 0
    follow = mouse

    # Geometry
    width = (0, 400)
    height = 300
    origin = top-right
    offset = 10x50
    scale = 0
    notification_limit = 5

    # Progress bar
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 2

    # Text
    font = CaskaydiaCove Nerd Font Mono 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    word_wrap = yes

    # Icons
    enable_recursive_icon_lookup = true
    icon_theme = WhiteSur-dark,Papirus-Dark,Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    # History
    sticky_history = yes
    history_length = 20

    # Misc/Advanced
    dmenu = /usr/bin/tofi --prompt-text "dunst ❯ "
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 12
    corners = all
    highlight = "#3182BD, #80B1D3, #756BB1"
    ignore_dbusclose = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    # Frame
    frame_width = 1
    frame_color = "#515253"
    separator_color = frame
    separator_height = 1
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    gap_size = 6

[urgency_low]
    background = "#0C0D0Ee6"
    foreground = "#959697"
    frame_color = "#737475"
    timeout = 4

[urgency_normal]
    background = "#0C0D0Ee6"
    foreground = "#FCFDFE"
    frame_color = "#515253"
    timeout = 6

[urgency_critical]
    background = "#0C0D0Ee6"
    foreground = "#E31A1C"
    frame_color = "#E31A1C"
    timeout = 0
