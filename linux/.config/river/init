#!/bin/sh
# river config.
#
# This file IS the configuration -- river has no config format, just a script of
# riverctl calls run at startup. Which is the point: everything here can be
# re-applied live. `Super+Shift+R` re-runs this file, so a keybind change costs
# nothing. No rebuild, no session restart, and critically no re-running of an
# audio launcher (see the run_once note below -- that is the dwl bug that ate a
# day).
#
# One config, two operating systems: Artix (runit, Linux) and OpenBSD. Anything
# that only exists on one of them is gated on `uname`, and nothing above that
# gate may assume Linux.
#
# Binds are ported from the dwl config; the layout keys necessarily differ,
# because river's layouts come from a separate generator process (rivertile)
# rather than twelve arrange() functions compiled in.

OS=$(uname -s)

# ---------------------------------------------------------------- helpers ----

# Spawn a daemon only if it is not already up. This is what makes re-running
# this file safe, and it is the fix for the trap dwl's autostart[] set: there,
# every reload re-ran `artix-pipewire-launcher restart` and tore down the whole
# pipewire stack, which repeatedly left the machine with three audio processes
# running and no ALSA devices at all.
run_once() {
	pgrep -x "$1" >/dev/null 2>&1 && return 0
	shift 2>/dev/null
	riverctl spawn "$*"
}

# ----------------------------------------------------------------- theme -----
# Framer, from coat. riverctl takes colours at runtime, so a scheme change is a
# handful of riverctl calls -- no recompile, unlike dwl. coat can write this file
# and everything below picks it up; without it the baked values apply.
COAT_NORM_BORDER=0x747474   # base03
COAT_SEL_BORDER=0xd0d0d0    # base05
COAT_URG_BORDER=0xfd886b    # base08
COAT_BG=0x181818            # base00
[ -r "$HOME/.config/river/coat-colors" ] && . "$HOME/.config/river/coat-colors"

riverctl background-color "$COAT_BG"
riverctl border-color-focused "$COAT_SEL_BORDER"
riverctl border-color-unfocused "$COAT_NORM_BORDER"
riverctl border-color-urgent "$COAT_URG_BORDER"
riverctl border-width 1

riverctl xcursor-theme rose-pine-cursor 24

# ----------------------------------------------------------------- input -----
riverctl focus-follows-cursor normal
riverctl set-repeat 50 200          # matches the sway and dwl configs
riverctl hide-cursor timeout 3000   # sway: hide_cursor 3000
riverctl hide-cursor when-typing enabled

# river's `input` takes an exact device name, and those names differ per machine
# (this laptop's touchpad is "ASUP1207:00 093A:3012 Touchpad", nothing like the
# "Elan Touchpad" that upstream configs assume -- a wrong guess there is what
# left dwl's touchpad toggle a silent no-op for weeks). So match on the word
# rather than hardcoding: this works on both machines and on the next one.
riverctl list-inputs 2>/dev/null | while IFS= read -r dev; do
	case "$dev" in
	*[Tt]ouchpad* | *[Tt]rackpad*)
		riverctl input "$dev" tap enabled
		riverctl input "$dev" drag enabled
		riverctl input "$dev" drag-lock enabled
		riverctl input "$dev" natural-scroll disabled
		riverctl input "$dev" disable-while-typing enabled
		# adaptive, not flat: flat makes crossing 2560px a multi-swipe affair.
		riverctl input "$dev" accel-profile adaptive
		;;
	*[Mm]ouse* | *[Pp]ointer*)
		# flat = no acceleration, which is what `input type:pointer
		# { accel_profile flat }` gave us under sway.
		riverctl input "$dev" accel-profile flat
		;;
	esac
done

# --------------------------------------------------------------- launch ------
riverctl map normal Super Q spawn foot
riverctl map normal Super+Shift Return spawn foot
# wmenu-run lists PATH binaries, dmenu_run style -- it is not a .desktop
# launcher like tofi-drun was. `fuzzel` is in both Arch and OpenBSD ports if the
# drun behaviour turns out to be missed.
riverctl map normal Super D spawn wmenu-run
riverctl map normal Super V spawn "sh -c 'cliphist list | wmenu -i -p clip | cliphist decode | wl-copy'"
riverctl map normal Super+Shift B spawn firefox
riverctl map normal Super T spawn theme-pick
riverctl map normal Super+Shift T spawn theme-random
riverctl map normal Super+Shift S spawn swayscreenshot
riverctl map normal Super+Shift E spawn swayscreenshot-edit
riverctl map normal Super+Shift P spawn "grimpicker -n -c"
riverctl map normal Super Escape spawn "swaylock -f"
# Re-run this file. river's answer to dwl-reload, minus the rebuild and minus
# losing every window that is not Qt6.
riverctl map normal Super+Shift R spawn "$HOME/.config/river/init"

# --------------------------------------------------------------- window ------
riverctl map normal Super C close
riverctl map normal Super+Shift C close
riverctl map normal Super Return zoom
riverctl map normal Super F toggle-fullscreen
riverctl map normal Super E toggle-fullscreen        # sway muscle memory
riverctl map normal Super+Shift Space toggle-float
# river has no togglebar; the bar is just a client, so stop or start it.
riverctl map normal Super P spawn "sh -c 'pkill -x waybar || waybar &'"

# ---------------------------------------------------------------- focus ------
riverctl map normal Super Left focus-view left
riverctl map normal Super Right focus-view right
riverctl map normal Super Up focus-view up
riverctl map normal Super Down focus-view down
riverctl map normal Super J focus-view next
riverctl map normal Super K focus-view previous
riverctl map normal Super Tab focus-view next
riverctl map normal Super Comma focus-output previous
riverctl map normal Super Period focus-output next

# ----------------------------------------------------------------- move ------
riverctl map normal Super+Shift J swap next
riverctl map normal Super+Shift K swap previous
riverctl map normal Super+Shift Left swap left
riverctl map normal Super+Shift Right swap right
riverctl map normal Super+Shift Up swap up
riverctl map normal Super+Shift Down swap down
riverctl map normal Super+Shift Less send-to-output previous
riverctl map normal Super+Shift Greater send-to-output next

# ---------------------------------------------------------------- sizing -----
riverctl map normal Super H send-layout-cmd rivertile "main-ratio -0.05"
riverctl map normal Super L send-layout-cmd rivertile "main-ratio +0.05"
riverctl map normal Super I send-layout-cmd rivertile "main-count +1"
riverctl map normal Super+Shift D send-layout-cmd rivertile "main-count -1"

# --------------------------------------------------------------- layouts -----
# rivertile is main-area-plus-stack in four orientations. It is NOT the twelve
# layouts dwl had: grid, spiral, deck and centered-master live in third-party
# generators (stacktile, kile-wl) that are not in OpenBSD ports. A generator is
# a small Wayland client, so porting one is an afternoon -- but out of the box,
# this is what there is.
riverctl map normal Super+Control T send-layout-cmd rivertile "main-location left"
riverctl map normal Super+Control S send-layout-cmd rivertile "main-location top"
riverctl map normal Super+Control O send-layout-cmd rivertile "main-location bottom"
riverctl map normal Super+Control R send-layout-cmd rivertile "main-location right"
riverctl map normal Super Space send-layout-cmd rivertile "main-location left"

# ------------------------------------------------------------------ gaps -----
# rivertile only takes padding as a startup flag -- there is no runtime command
# for it -- so river-gaps restarts the generator with new numbers. 8px to match
# what the dwl config settled on.
riverctl map normal Super+Alt H spawn "river-gaps +1"
riverctl map normal Super+Alt L spawn "river-gaps -1"
riverctl map normal Super+Alt G spawn "river-gaps reset"
riverctl map normal Super+Alt 0 spawn "river-gaps toggle"

# ------------------------------------------------------------------ tags -----
# Ten tags, matching the dwl config (which matched sway's ten workspaces).
for i in $(seq 1 9); do
	tag=$((1 << (i - 1)))
	riverctl map normal Super "$i" set-focused-tags "$tag"
	riverctl map normal Super+Shift "$i" set-view-tags "$tag"
	riverctl map normal Super+Control "$i" toggle-focused-tags "$tag"
	riverctl map normal Super+Shift+Control "$i" toggle-view-tags "$tag"
done
# 0 is the tenth tag, not view-all -- again matching the dwl and sway configs.
riverctl map normal Super 0 set-focused-tags $((1 << 9))
riverctl map normal Super+Shift 0 set-view-tags $((1 << 9))
riverctl map normal Super+Control 0 toggle-focused-tags $((1 << 9))
riverctl map normal Super+Shift+Control 0 toggle-view-tags $((1 << 9))

# ------------------------------------------------------------- scratchpad ----
# river has no scratchpad. The idiom is a tag you never `view` by accident: tag
# 11, past the ten bound above. One slot rather than dwl's three.
SCRATCH=$((1 << 10))
riverctl map normal Super+Shift Z set-view-tags $SCRATCH
riverctl map normal Super+Control Z toggle-focused-tags $SCRATCH
riverctl map normal Super Z set-view-tags $((1 << 0))   # pull it back to tag 1

# ------------------------------------------------------------ media keys -----
riverctl map normal None XF86AudioRaiseVolume spawn "osd volume up"
riverctl map normal None XF86AudioLowerVolume spawn "osd volume down"
riverctl map normal None XF86AudioMute spawn "osd volume mute"
riverctl map normal None XF86AudioMicMute spawn "osd mic mute"
riverctl map normal None XF86AudioPlay spawn "osd playpause"
riverctl map normal None XF86Launch3 spawn "osd playpause"
riverctl map normal None XF86MonBrightnessUp spawn "osd brightness up"
riverctl map normal None XF86MonBrightnessDown spawn "osd brightness down"

# The touchpad toggle needs the device name too, so it goes through a helper
# that does the same list-inputs match as the input block above.
riverctl map normal None XF86TouchpadToggle spawn river-touchpad
riverctl map normal Super+Alt V spawn river-touchpad

# Lock-key indicators. river has `map -release`, which dwl's keypress path could
# not do -- so the caps/num lock OSD that had to be dropped in the move off sway
# works again. -release matters: on press the kernel LED has not flipped yet.
riverctl map -release normal None Caps_Lock spawn "osd capslock"
riverctl map -release normal None Num_Lock spawn "osd numlock"

# ----------------------------------------------------------------- mouse -----
riverctl map-pointer normal Super BTN_LEFT move-view
riverctl map-pointer normal Super BTN_RIGHT resize-view
riverctl map-pointer normal Super BTN_MIDDLE toggle-float

# ---------------------------------------------------------- resize mode ------
# Mirrors sway's `mode "resize"` and the dwl port of it. Note river's modes are
# strictly scoped the same way dwl's were: while you are in here, none of the
# Super binds above respond. Return or Escape gets out.
riverctl declare-mode resize
riverctl map normal Super R enter-mode resize
for k in Left h; do
	riverctl map resize None "$k" send-layout-cmd rivertile "main-ratio -0.025"
done
for k in Right l; do
	riverctl map resize None "$k" send-layout-cmd rivertile "main-ratio +0.025"
done
for k in Up k; do
	riverctl map resize None "$k" send-layout-cmd rivertile "main-count +1"
done
for k in Down j; do
	riverctl map resize None "$k" send-layout-cmd rivertile "main-count -1"
done
riverctl map resize None Return enter-mode normal
riverctl map resize None Escape enter-mode normal

# ----------------------------------------------------------------- rules -----
riverctl rule-add -app-id 'float*' float
riverctl rule-add -app-id 'pinentry*' float
riverctl rule-add -title 'Picture-in-Picture' float
# Everything gets server-side borders so windows look the same regardless of
# whether the toolkit wanted to draw its own.
riverctl rule-add ssd

# ------------------------------------------------------------- autostart -----
# Portable first, then the per-OS bits.
run_once swaybg swaybg -m fill -i "$HOME/jbwallpapers/wallpapers/Matanuska-River-ENBLA05.jpg"
run_once fnott fnott
run_once waybar waybar
run_once swayidle swayidle -w -C "$HOME/.config/swayidle/config"
run_once kanshi kanshi
pgrep -f 'wl-paste --type text' >/dev/null 2>&1 || \
	riverctl spawn "wl-paste --type text --watch cliphist store"
pgrep -f 'wl-paste --type image' >/dev/null 2>&1 || \
	riverctl spawn "wl-paste --type image --watch cliphist store"

if [ "$OS" = Linux ]; then
	riverctl spawn "dbus-update-activation-environment --all"
	riverctl spawn "dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=river"
	run_once wl-clip-persist wl-clip-persist --clipboard regular
	run_once start-polkit start-polkit
	run_once canvas-notify canvas-notify
	[ -x /usr/lib/xdg-desktop-portal-wlr ] && \
		run_once xdg-desktop-portal-wlr /usr/lib/xdg-desktop-portal-wlr
	# NOT wrapped in a restart. Audio must not be a child of the compositor's
	# lifecycle -- that is exactly what made every dwl reload kill the sound.
	# If there is no working sink, bring the stack up; otherwise leave it alone.
	wpctl status 2>/dev/null | grep -q 'Sinks:' || \
		riverctl spawn "artix-pipewire-launcher restart"
	run_once nvibrant nvibrant 1023 1023 1023 1023
	riverctl spawn refresh-paru-completions
fi

# --------------------------------------------------------------- layout ------
# Last, so the generator is running before the first view is mapped.
run_once rivertile rivertile -view-padding 8 -outer-padding 8 -main-ratio 0.55
riverctl default-layout rivertile
