# tofi — launcher ($mod+d runs tofi-drun; theme-pick and wlboard use tofi as a
# dmenu). Colours, font and font size come from coat via the include below;
# everything after it is layout and behaviour, which coat no longer touches.
#
# The include is resolved relative to this file, and tofi applies it the moment
# it reads the line — so any colour set after it here would win.
include=coat-theme

# Geometry — centered box.
#
# tofi has no auto-sizing: width/height are fixed, and any height beyond what
# num-results fills is dead space. So height is sized TO the list —
# padding-top + input row + (num-results * row) + padding-bottom, where a row
# is roughly the font size in px plus result-spacing. Change num-results and
# this has to move with it, or the box goes hollow at the bottom again.
anchor = center
width = 560
height = 240
horizontal = false
corner-radius = 14
border-width = 2
outline-width = 0
padding-top = 16
padding-bottom = 16
padding-left = 20
padding-right = 20
result-spacing = 4
num-results = 8
min-input-width = 120

prompt-text = "❯ "
prompt-padding = 12
# An empty input line reads as a broken window; a placeholder and a visible
# cursor make it look like it's waiting for you.
placeholder-text = "search…"
text-cursor = true
fuzzy-match = true
history = true
require-match = false
# `foot`, not `footclient`: footclient needs a `foot --server` daemon and fails
# outright without one. Plain foot starts fast enough that the server isn't
# worth the extra failure mode.
terminal = foot
drun-launch = true

# Selection highlight geometry. Directional: "top&bottom, left&right" (comma
# separated, CSS-like). Extra horizontal padding so the selection reads as a row
# highlight instead of a pill clinging to the text.
selection-background-padding = 4, 12
selection-background-corner-radius = 8
