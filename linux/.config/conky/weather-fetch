#!/bin/sh
# Locate, then fetch the weather. Called by conky's weather block every 5 min.
#
# A script rather than an exec line because conky silently truncates an exec
# command past roughly 200 characters and this is two chained requests; it lives
# next to weather.jq rather than in ~/.local/bin because it is part of this
# panel's config, not a command anyone would run.
#
# ── Location ────────────────────────────────────────────────────────────────
# IP geolocation, because nothing better is available on this machine:
#
#   GPS      -- no radio. Checked: no /dev/gnss*, no WWAN modem.
#   WiFi     -- BeaconDB returns 404 for the access points here; they are not in
#               the crowdsourced database. GeoClue uses the same database, so
#               configuring GeoClue would not change the answer.
#   IP       -- what is left. Kilometre-scale at best, and on a university or
#               corporate network it reports where the NETWORK is registered
#               rather than where you are.
#
# So treat the coordinates as approximate. The panel's first line shows the grid
# point Open-Meteo actually answered for -- if it looks wrong, put your real
# numbers in ~/.config/conky/weather.coords as "lat lon" on one line and this
# stops asking the network entirely.
#
# Location is cached for an hour: an IP does not move on a 5-minute timer, and
# ipapi.co's free tier is 1000 requests a day, which a 5-minute refresh would eat.
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"
LOC="$CACHE/conky-loc.json"
WX="$CACHE/conky-wx.json"
OVERRIDE="$HOME/.config/conky/weather.coords"

if [ -r "$OVERRIDE" ]; then
	read -r LAT LON <"$OVERRIDE"
else
	# -mmin +60 prints the file only when it is older than an hour, so a missing
	# file and a stale one take the same branch.
	if [ ! -s "$LOC" ] || [ -n "$(find "$LOC" -mmin +60 2>/dev/null)" ]; then
		curl -sm 15 --fail https://ipapi.co/json/ -o "$LOC.new" &&
			mv -f "$LOC.new" "$LOC"
		rm -f "$LOC.new"
	fi
	LAT=$(jq -r '.latitude // empty' "$LOC" 2>/dev/null)
	LON=$(jq -r '.longitude // empty' "$LOC" 2>/dev/null)
fi

# No coordinates means no request. Leaving the previous cache alone is the right
# failure: the panel keeps showing the last good reading with its own timestamp,
# rather than going blank or silently reporting somewhere else.
[ -n "$LAT" ] && [ -n "$LON" ] || exit 0

# ── Weather ─────────────────────────────────────────────────────────────────
# Three sources merged into ONE cache file so the renderer reads one document and
# a single API being down cannot half-draw the panel:
#
#   forecast   Open-Meteo. No key, exact coordinates, `interval: 900`.
#   air        Open-Meteo air-quality, for the AQI alone.
#   alerts     NWS. US only, free, no key, but it requires a User-Agent that
#              identifies you -- the API returns 403 to a generic one.
#
# Only the fields the panel draws are requested. It briefly asked for everything
# these APIs serve -- soil, radiation, CAPE, lifted index, boundary layer, a
# 15-minute nowcast -- and the panel became unreadable; `git log` has the list if
# any of it is ever wanted back. Two fields are not available here at all, so do
# not go looking: pollen (CAMS) and lightning_potential (ICON-D2) are Europe-only
# and return null in North America.
T=$(mktemp -d) || exit 0
trap 'rm -rf "$T"' EXIT

F="latitude=$LAT&longitude=$LON&timezone=auto"
U="temperature_unit=fahrenheit&wind_speed_unit=mph&precipitation_unit=inch"

CUR="temperature_2m,apparent_temperature,relative_humidity_2m,dew_point_2m"
CUR="$CUR,weather_code,pressure_msl,visibility,uv_index"
CUR="$CUR,wind_speed_10m,wind_direction_10m,wind_gusts_10m"
DAY="weather_code,temperature_2m_max,temperature_2m_min,uv_index_max"
DAY="$DAY,precipitation_probability_max,sunrise,sunset"

curl -sm 15 --fail "https://api.open-meteo.com/v1/forecast?$F&$U&current=$CUR&hourly=temperature_2m,precipitation_probability,weather_code&daily=$DAY&forecast_days=3" -o "$T/wx.json"

curl -sm 15 --fail "https://air-quality-api.open-meteo.com/v1/air-quality?$F&current=us_aqi" -o "$T/aq.json"

curl -sm 15 --fail -H "User-Agent: conky-weather (am397421@ucf.edu)" "https://api.weather.gov/alerts/active?point=$LAT,$LON" -o "$T/al.json"

# The forecast is the only load-bearing one. Air and alerts degrade to empty
# objects and weather.jq simply omits what it cannot draw.
[ -s "$T/wx.json" ] || exit 0

# The location lookup is carried through so the panel can say "Orlando, FL"
# instead of a pair of coordinates. Absent when weather.coords overrides it.
[ -r "$LOC" ] || echo '{}' >"$T/loc.json"
[ -r "$LOC" ] && cp "$LOC" "$T/loc.json"

jq -n \
	--slurpfile wx "$T/wx.json" \
	--slurpfile aq "$T/aq.json" \
	--slurpfile al "$T/al.json" \
	--slurpfile loc "$T/loc.json" \
	'{wx: ($wx[0] // {}), aq: ($aq[0] // {}), alerts: ($al[0] // {}), loc: ($loc[0] // {})}' \
	>"$T/merged.json" 2>/dev/null || exit 0

# Moved into place so conky never reads a half-written cache -- the render runs
# on the same 5-minute tick as this fetch.
mv -f "$T/merged.json" "$WX"
