# swaylock — Framer (base16), replacing gtklock.
#
# Without a config swaylock locks to a flat white screen, which after a lid close
# on an OLED is genuinely unpleasant. Colours are RRGGBB[AA] with no leading '#'.
#
# Only base00/base03/base05/base0D/base08 are used. base01/02/04/06 are not
# reliable across schemes -- plenty of base16 palettes leave them at contrast
# ratios where the indicator ring vanishes against the background.

# No image: swaybg's wallpaper is not visible under a lock surface anyway, and
# reading the wallpaper file on every lock is wasted IO on a 13MB JPEG.
color=181818

indicator
indicator-radius=90
indicator-thickness=6
indicator-caps-lock

# Ring: accent while idle, base05 while typing, base08 on a wrong password.
ring-color=20BCFC
ring-clear-color=FECB6E
ring-ver-color=D0D0D0
ring-wrong-color=FD886B

inside-color=18181800
inside-clear-color=18181800
inside-ver-color=18181800
inside-wrong-color=18181800

key-hl-color=D0D0D0
bs-hl-color=FD886B
separator-color=00000000

text-color=D0D0D0
text-clear-color=D0D0D0
text-ver-color=D0D0D0
text-wrong-color=FD886B
font=MartianMono Nerd Font Mono
font-size=14

# Caps lock is worth surfacing here specifically: mango has no release-triggered
# keybinding, so the caps-lock OSD is unbound, and a lock screen is exactly where
# a silent caps lock costs you three failed attempts.
text-caps-lock-color=FECB6E
ring-caps-lock-color=FECB6E
inside-caps-lock-color=18181800
caps-lock-key-hl-color=FECB6E
caps-lock-bs-hl-color=FD886B

# Fail closed. Without this a crashed swaylock leaves the session unlocked.
ignore-empty-password
show-failed-attempts
