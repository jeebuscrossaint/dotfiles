# ~/.config/swaylock/config — the screen lock.
#
# swaylock because it is the only Wayland locker in BOTH Arch and OpenBSD ports
# (hyprlock, waylock and gtklock are all Linux-only), and this setup has to run
# on the OpenBSD box too. It speaks ext-session-lock, which mango implements.
#
# coat patches the colour keys into this file in place (swaylock.tera) and leaves
# every other line alone, so the geometry and behaviour below survive a
# `coat set`. Colours here are placeholders for a first run.

# Fork after the lock surface is up, so the caller returns instead of blocking.
# swayidle's timeout and the Super+L bind both rely on this.
daemonize

# No image, no blur, no fade: a flat wall of colour. Cheapest thing to draw, and
# there is no wallpaper daemon involved in it.
color=151515

indicator
indicator-radius=90
indicator-thickness=6
indicator-caps-lock

# Typing shows progress but never the length. Showing the count is a free hint to
# anyone watching, and swaylock's default draws one segment per character.
disable-caps-lock-text=false
show-failed-attempts

font=SFMono Nerd Font Mono
font-size=16

ring-color=3777E6
ring-clear-color=ABA800
ring-ver-color=D0D0D0
ring-wrong-color=FF0086

inside-color=15151500
inside-clear-color=15151500
inside-ver-color=15151500
inside-wrong-color=15151500

key-hl-color=D0D0D0
bs-hl-color=FF0086

text-color=D0D0D0
text-clear-color=D0D0D0
text-ver-color=D0D0D0
text-wrong-color=FF0086

separator-color=00000000
text-caps-lock-color = ABA800
ring-caps-lock-color = ABA800
inside-caps-lock-color = 15151500
caps-lock-key-hl-color = ABA800
caps-lock-bs-hl-color = FF0086
