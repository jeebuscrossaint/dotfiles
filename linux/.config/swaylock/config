# ~/.config/swaylock/config — the screen lock.
#
# swaylock because it is the only Wayland locker in BOTH Arch and OpenBSD ports
# (hyprlock, waylock and gtklock are all Linux-only). It speaks ext-session-lock,
# which mango implements.
#
# Geometry and behaviour only. The scheme is in coat-theme.conf beside this file
# and arrives as command-line flags — see do_lock in idle-guard, which explains
# why. ~/.config/swaylock must stay a real directory for that, with only this
# file symlinked.

# Fork after the lock surface is up, so the caller returns instead of blocking.
# swayidle's timeout and the Super+L bind both rely on this.
daemonize

# No image= — idle-guard passes the wallpaper as -i, resolved at lock time. Do
# not put one back: the line that used to be here was rewritten on every
# wallpaper change, which made every wallpaper change a diff in the repo.
scaling=fill

# The whole lock screen is this one dial, so it is drawn large: 110px radius,
# with a band thick enough that a single keypress segment is a visible arc rather
# than a tick. swaylock strokes a 2px line-color circle at BOTH edges of the
# band, and coat paints those in the background colour to cut the ring away from
# the disc and the wall behind it.
indicator-radius=110
indicator-thickness=10
indicator-caps-lock

# From the moment the screen locks, not the first keypress: there is nothing else
# on this screen, and without it a locked panel looks like a dead one.
indicator-idle-visible

show-failed-attempts
font-size=18
color=000000
ring-color=5993D2
ring-clear-color=C7B74C
ring-ver-color=C0BFBF
ring-wrong-color=C57046
inside-color=282727e6
inside-clear-color=C7B74C33
inside-ver-color=5993D233
inside-wrong-color=C5704633
key-hl-color=C0BFBF
bs-hl-color=C57046
line-color=000000
line-clear-color=000000
line-ver-color=000000
line-wrong-color=000000
line-caps-lock-color=000000
separator-color=00000000
text-color=C0BFBF
text-clear-color=C0BFBF
text-ver-color=C0BFBF
text-wrong-color=C57046
text-caps-lock-color=C7B74C
ring-caps-lock-color=C7B74C
inside-caps-lock-color=C7B74C33
caps-lock-key-hl-color=C7B74C
caps-lock-bs-hl-color=C57046
font=JetBrainsMono Nerd Font Mono

# Not a setting, a warning: do not add disable-caps-lock-text=false. The option
# takes no argument, so the parser rejects it outright — it reads as "keep the
# text" and does nothing at all.
