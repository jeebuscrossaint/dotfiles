# ~/.config/swaylock/config — the screen lock.
#
# swaylock because it is the only Wayland locker in BOTH Arch and OpenBSD ports
# (hyprlock, waylock and gtklock are all Linux-only), and this setup has to run
# on the OpenBSD box too. It speaks ext-session-lock, which mango implements.
#
# coat patches the colour keys into this file in place (swaylock.tera) and leaves
# every other line alone, so the geometry and behaviour below survive a
# `coat set`. Colours here are placeholders for a first run.

# Fork after the lock surface is up, so the caller returns instead of blocking.
# swayidle's timeout and the Super+L bind both rely on this.
daemonize

# NO image= here, deliberately. The lock shows the desktop wallpaper, but it is
# passed as -i by idle-guard, which asks the wallpaper daemon at the moment of
# locking. This file used to carry an image= line that a wrapper around awww
# rewrote on every wallpaper change -- a program editing a config file that is a
# stow symlink into the repo, so every wallpaper change was a one-line diff.
# swaylock has no variables to do it in-file; it does take -i.
#
# color= is the fallback, not dead config: it is what swaylock paints when there
# is no wallpaper to name -- a missing daemon, a deleted file, or the OpenBSD
# box, which has no awww at all. coat keeps it on-scheme.
scaling=fill
color=1C1C1C

# The whole lock screen is this one dial, so it is drawn large: 110px radius on
# a 1600px panel, with a band thick enough that a single keypress segment is a
# visible arc rather than a tick. swaylock also strokes a 2px line-color circle
# at BOTH edges of the band -- coat paints those in the background colour, which
# cuts the ring away from the disc inside it and from the wall behind it.
indicator-radius=110
indicator-thickness=10
indicator-caps-lock

# Drawn from the moment the screen locks, not on the first keypress. There is
# nothing else on this screen; without it the panel is an unbroken flat field
# and the lock looks like a dead display rather than a locked one.
indicator-idle-visible

# The caps-lock text is on by default and there is deliberately no
# disable-caps-lock-text line: that option takes no argument, so the
# `disable-caps-lock-text=false` that used to sit here was rejected outright by
# the parser. It read as "keep the text" and did nothing at all -- the text was
# only ever showing because the default shows it.
show-failed-attempts

font=JetBrainsMono Nerd Font Mono
font-size=18

ring-color=5FAFD7
ring-clear-color=D7AF5F
ring-ver-color=D0D0D0
ring-wrong-color=AF005F

inside-color=303030e6
inside-clear-color=D7AF5F33
inside-ver-color=5FAFD733
inside-wrong-color=AF005F33

key-hl-color=D0D0D0
bs-hl-color=AF005F

text-color=D0D0D0
text-clear-color=D0D0D0
text-ver-color=D0D0D0
text-wrong-color=AF005F

separator-color=00000000
text-caps-lock-color=D7AF5F
ring-caps-lock-color=D7AF5F
inside-caps-lock-color=D7AF5F33
caps-lock-key-hl-color=D7AF5F
caps-lock-bs-hl-color=AF005F
line-color=1C1C1C
line-clear-color=1C1C1C
line-ver-color=1C1C1C
line-wrong-color=1C1C1C
line-caps-lock-color=1C1C1C
