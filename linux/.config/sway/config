# Sway configuration

include ~/.config/sway/coat-theme
# swaybar block (status_command = swayrbar), generated by coat's swaybar module.
# The whole block is generated, not just the colors — sway rejects `include`
# inside `bar { }`, so a colors-only fragment can't be spliced in.
include ~/.config/sway/coat-bar

# Override: dark titlebar bg matching terminal
client.focused $base0D $base00 $base0D $base0C $base0C

set $mod Mod4
set $menu tofi-drun
set $term foot

xwayland enable

# Window appearance
# `pixel`, not `normal`: normal draws a titlebar. Floating windows need their
# own directive — default_border does not cover them.
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Gaps
gaps inner 0
gaps outer 0
smart_gaps on
smart_borders on

# Input
input type:touchpad {
    natural_scroll disabled
}

input type:pointer {
    accel_profile flat
}

input type:keyboard {
    repeat_delay 200
    repeat_rate 50
}

seat * hide_cursor 3000
focus_follows_mouse yes
floating_modifier $mod

# Output
output * {
    render_bit_depth 10
    color_profile srgb
}

output eDP-1 {
    mode 2560x1600@240Hz
    position 0,0
}

output HDMI-A-1 {
    mode 3840x2160@30Hz
    position 2560,0
}


# Keybinds
bindsym $mod+q exec $term
bindsym $mod+d exec $menu
bindsym $mod+c kill
bindsym $mod+Shift+c reload
# swaylock-once, not swaylock: single-instance guard + -f, so a manual lock
# can't stack with one swayidle is already putting up. Same for swayidle's own
# invocations in ~/.config/swayidle/config.
bindsym $mod+l exec swaylock-once
bindsym $mod+Delete exec wlboard
bindsym $mod+p exec swaymsg bar mode toggle     # show/hide swaybar
bindsym $mod+t exec theme-pick                  # tofi coat scheme picker
bindsym $mod+Shift+t exec theme-random          # random coat scheme
bindsym $mod+Shift+s exec swayscreenshot
bindsym $mod+Shift+e exec swayscreenshot-edit   # region -> satty annotator
bindsym $mod+Shift+p exec grimpicker -n -c      # pick a color, copy hex, notify
bindsym $mod+v exec cliphist list | tofi --prompt-text "clip ❯ " | cliphist decode | wl-copy

# Focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
#bindsym $mod+h focus left
#bindsym $mod+j focus down
#bindsym $mod+k focus up
#bindsym $mod+l focus right

# Move
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout
bindsym $mod+Shift+v floating toggle
bindsym $mod+f fullscreen
bindsym $mod+m fullscreen                       # muscle memory (same as $mod+f)
bindsym $mod+r mode "resize"
bindsym $mod+backslash split toggle             # flip the split direction
bindsym $mod+g layout toggle split tabbed       # tabbed window group
bindsym $mod+Tab focus next sibling             # cycle tabs within the group

# Scratchpad (hyprland's special:magic workspace)
bindsym $mod+grave scratchpad show
bindsym $mod+Shift+grave move scratchpad

# Media keys — swayosd OSD (swayosd-server started below).
# swayosd-client both performs the change and draws the OSD, so there's no
# separate volumectl/lightctl step. ~/.local/bin/volumectl is left alone.
bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume raise
bindsym XF86AudioLowerVolume exec swayosd-client --output-volume lower
bindsym XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym XF86AudioMicMute exec swayosd-client --input-volume mute-toggle
bindsym XF86Launch3 exec swayosd-client --playerctl play-pause
bindsym XF86AudioPlay exec swayosd-client --playerctl play-pause
bindsym XF86TouchpadToggle input type:touchpad events toggle enabled disabled
# --device intel_backlight: the OLED panel is on the Intel card, not nvidia_0.
bindsym XF86MonBrightnessUp exec swayosd-client --brightness raise --device intel_backlight
bindsym XF86MonBrightnessDown exec swayosd-client --brightness lower --device intel_backlight

# Lock-key indicators. A compositor bind is all this needs — the OSD only
# *displays* the state, the key still toggles it normally. --release so the
# state has already flipped by the time swayosd-client reads it.
# (swayosd-libinput-backend would catch these without a bind, but it wants root
# and a service unit: its D-Bus activation file is Exec=/bin/false + a systemd
# reference, so it can't self-activate on Artix.)
bindsym --release Caps_Lock exec swayosd-client --caps-lock
bindsym --release Num_Lock exec swayosd-client --num-lock

# Resize mode
mode "resize" {
    bindsym Left  resize shrink width  20px
    bindsym Down  resize grow   height 20px
    bindsym Up    resize shrink height 20px
    bindsym Right resize grow   width  20px
    bindsym h resize shrink width  20px
    bindsym j resize grow   height 20px
    bindsym k resize shrink height 20px
    bindsym l resize grow   width  20px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# The bar is swaybar. Its block comes from the `include ~/.config/sway/coat-bar`
# at the top of this file — do NOT add a bar { } block here, sway would create a
# second bar rather than merge with that one.

# Startup
exec dbus-update-activation-environment --all
exec autotiling-rs
exec swayidle -w -C ~/.config/swayidle/config
exec dunst
# Supervised, not a bare `exec swayosd-server`: if the server dies mid-session
# every media key silently stops working (swayosd-client just fails), and `exec`
# never fires again to bring it back. See the script for the coat interaction.
exec swayosd-supervise   # volume/brightness/lock-key OSD (themed by coat)
# Clipboard history (cliphist) — watch both text and images; recall with $mod+v
# wl-clip-persist keeps a selection readable after the source app exits.
# `regular` only, not `both`: with the primary selection included it re-offers
# every mouse-drag highlight and cliphist stores each one.
exec wl-clip-persist --clipboard regular
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec sh -c 'command -v nm-applet && nm-applet'
exec dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec start-polkit
exec canvas-notify
exec /usr/libexec/xdg-desktop-portal-wlr
exec /usr/libexec/xdg-desktop-portal
#exec /usr/bin/pipewire
#exec /usr/bin/pipewire-pulse
#exec /usr/bin/wireplumber
# `restart`, not bare: the launcher bails at "already running" if it sees ANY
# pipewire process, and never reaches its wireplumber line. A pipewire left over
# from a previous session holds unlinked sockets in a deleted runtime dir, so it
# looks alive but nothing can connect and no session manager ever starts —
# silently dead audio. restart kills the stale stack and brings up all three.
exec artix-pipewire-launcher restart
exec nvibrant 1023 1023 1023 1023
exec refresh-paru-completions

# SwayFX
# SwayFX effects
#corner_radius 0
#smart_corner_radius enable
#blur disable
#blur_passes 2
#blur_radius 3
#blur_xray disable

#shadows disable
#shadows_on_csd enable
#shadow_blur_radius 10
#shadow_color $base00
#shadow_inactive_color $base00
#shadow_offset 0 0

#default_dim_inactive 0.0
#dim_inactive_colors.unfocused $base00
#dim_inactive_colors.urgent $base08

#titlebar_separator disable
#scratchpad_minimize disable


