# Sway configuration

include ~/.config/sway/coat-theme
# swaybar block (status_command = swayrbar), generated by coat's swaybar module.
# The whole block is generated, not just the colors — sway rejects `include`
# inside `bar { }`, so a colors-only fragment can't be spliced in.
include ~/.config/sway/coat-bar

set $mod Mod4
set $menu tofi-drun
set $term foot

xwayland enable

# Window appearance
# `normal`, so windows get a titlebar. Floating windows need their own
# directive — default_border does not cover them.
default_border normal 1
default_floating_border normal 1
# `none`, not `smart`: hide_edge_borders smart is an alias for `smart_borders
# smart` + `hide_edge_borders none`, so it would switch smart borders back on.
hide_edge_borders none

# Gaps
gaps inner 0
gaps outer 0
smart_gaps on
# off: sway has no smart *titlebars*, so a lone window kept its titlebar while
# smart_borders stripped the frame around it — titlebar and no border looked
# broken. Borders are on always now, matching the titlebar.
smart_borders off

# Input
input type:touchpad {
    natural_scroll disabled
}

input type:pointer {
    accel_profile flat
}

input type:keyboard {
    repeat_delay 200
    repeat_rate 50
}

seat * hide_cursor 3000
focus_follows_mouse yes
floating_modifier $mod

# Output
output * {
    render_bit_depth 10
    color_profile srgb
}

output eDP-1 {
    mode 2560x1600@240Hz
    position 0,0
}

output HDMI-A-1 {
    mode 3840x2160@30Hz
    position 2560,0
}


# Keybinds
bindsym $mod+q exec $term
bindsym $mod+d exec $menu
bindsym $mod+c kill
bindsym $mod+Shift+c reload
# gtklock-once, not bare gtklock: single-instance guard + -d, so a manual lock
# can't stack with one swayidle is already putting up. Same for swayidle's own
# invocations in ~/.config/swayidle/config.
bindsym $mod+l exec gtklock-once
bindsym $mod+Delete exec wlboard
bindsym $mod+p exec swaymsg bar mode toggle     # show/hide swaybar
bindsym $mod+t exec theme-pick                  # tofi coat scheme picker
bindsym $mod+Shift+t exec theme-random          # random coat scheme
bindsym $mod+Shift+s exec swayscreenshot
bindsym $mod+Shift+e exec swayscreenshot-edit   # region -> satty annotator
bindsym $mod+Shift+p exec grimpicker -n -c      # pick a color, copy hex, notify
bindsym $mod+v exec cliphist list | tofi --prompt-text "clip ❯ " | cliphist decode | wl-copy

# Focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
#bindsym $mod+h focus left
#bindsym $mod+j focus down
#bindsym $mod+k focus up
#bindsym $mod+l focus right

# Move
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout
bindsym $mod+Shift+v floating toggle
bindsym $mod+f fullscreen
bindsym $mod+m fullscreen                       # muscle memory (same as $mod+f)
bindsym $mod+r mode "resize"
bindsym $mod+backslash split toggle             # flip the split direction
bindsym $mod+g layout toggle split tabbed       # tabbed window group
bindsym $mod+Tab focus next sibling             # cycle tabs within the group

# Scratchpad (hyprland's special:magic workspace)
bindsym $mod+grave scratchpad show
bindsym $mod+Shift+grave move scratchpad

# Media keys. ~/.local/bin/osd both performs the change and draws the OSD as a
# dunst notification — swayosd was retired 2026-08-11 because coat could only
# restyle it by killing its server, which raced the supervisor keeping that
# server alive and left the media keys silently dead. There is nothing to start
# for this: dunst is already running. ~/.local/bin/volumectl is left alone.
bindsym XF86AudioRaiseVolume exec osd volume up
bindsym XF86AudioLowerVolume exec osd volume down
bindsym XF86AudioMute exec osd volume mute
bindsym XF86AudioMicMute exec osd mic mute
bindsym XF86Launch3 exec osd playpause
bindsym XF86AudioPlay exec osd playpause
bindsym XF86TouchpadToggle input type:touchpad events toggle enabled disabled
# The backlight device is intel_backlight, set in the script: the OLED panel is
# on the Intel card, not nvidia_0.
bindsym XF86MonBrightnessUp exec osd brightness up
bindsym XF86MonBrightnessDown exec osd brightness down

# Lock-key indicators. A compositor bind is all this needs — the OSD only
# *displays* the state, the key still toggles it normally. --release so the
# state has already flipped by the time the script reads the keyboard LED.
bindsym --release Caps_Lock exec osd capslock
bindsym --release Num_Lock exec osd numlock

# Resize mode
mode "resize" {
    bindsym Left  resize shrink width  20px
    bindsym Down  resize grow   height 20px
    bindsym Up    resize shrink height 20px
    bindsym Right resize grow   width  20px
    bindsym h resize shrink width  20px
    bindsym j resize grow   height 20px
    bindsym k resize shrink height 20px
    bindsym l resize grow   width  20px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# The bar is swaybar. Its block comes from the `include ~/.config/sway/coat-bar`
# at the top of this file — do NOT add a bar { } block here, sway would create a
# second bar rather than merge with that one.

# Startup
exec dbus-update-activation-environment --all
exec autotiling-rs
exec swayidle -w -C ~/.config/swayidle/config
exec dunst   # also draws the media-key OSD — see the media keys section above
# Clipboard history (cliphist) — watch both text and images; recall with $mod+v
# wl-clip-persist keeps a selection readable after the source app exits.
# `regular` only, not `both`: with the primary selection included it re-offers
# every mouse-drag highlight and cliphist stores each one.
exec wl-clip-persist --clipboard regular
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec sh -c 'command -v nm-applet && nm-applet'
exec dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec start-polkit
exec canvas-notify
exec /usr/libexec/xdg-desktop-portal-wlr
exec /usr/libexec/xdg-desktop-portal
#exec /usr/bin/pipewire
#exec /usr/bin/pipewire-pulse
#exec /usr/bin/wireplumber
# `restart`, not bare: the launcher bails at "already running" if it sees ANY
# pipewire process, and never reaches its wireplumber line. A pipewire left over
# from a previous session holds unlinked sockets in a deleted runtime dir, so it
# looks alive but nothing can connect and no session manager ever starts —
# silently dead audio. restart kills the stale stack and brings up all three.
exec artix-pipewire-launcher restart
exec nvibrant 1023 1023 1023 1023
exec refresh-paru-completions

# SwayFX
# SwayFX effects
#corner_radius 0
#smart_corner_radius enable
#blur disable
#blur_passes 2
#blur_radius 3
#blur_xray disable

#shadows disable
#shadows_on_csd enable
#shadow_blur_radius 10
#shadow_color $base00
#shadow_inactive_color $base00
#shadow_offset 0 0

#default_dim_inactive 0.0
#dim_inactive_colors.unfocused $base00
#dim_inactive_colors.urgent $base08

#titlebar_separator disable
#scratchpad_minimize disable


