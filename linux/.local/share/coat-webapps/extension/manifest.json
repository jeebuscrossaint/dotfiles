{
  "manifest_version": 3,
  "name": "coat web app theme",
  "version": "0.1.0",
  "description": "Make web apps follow the active coat scheme: palette, accent, and light/dark.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "*://discord.com/*",
    "*://github.com/*",
    "*://gist.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://discord.com/*",
        "*://github.com/*",
        "*://gist.github.com/*"
      ],
      "js": [
        "inject-prefers-color-scheme.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://discord.com/*",
        "*://github.com/*",
        "*://gist.github.com/*"
      ],
      "js": [
        "coat-colors.js",
        "coat-surfaces.js",
        "coat-runtime.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://discord.com/*"
      ],
      "js": [
        "discord.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://github.com/*",
        "*://gist.github.com/*"
      ],
      "js": [
        "github.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
