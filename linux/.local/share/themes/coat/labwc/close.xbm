/* close.xbm — traffic-light button mask, 13x13.
 *
 * A filled disc, and deliberately NO colour: xbm is a 1-bit mask (0=clear,
 * 1=painted) and labwc fills it with the per-button colour from themerc, which coat
 * generates. That is the whole reason these are xbm rather than png or svg -- an
 * image file would bake in three fixed hex values and stop following the scheme.
 * close, iconify and max are identical shapes; only their themerc colours differ,
 * exactly as on macOS.
 *
 * The disc is decided by AREA COVERAGE (supersampled 4x4, set when over half the
 * pixel falls inside), not by a centre-point test. xbm cannot anti-alias, so that
 * is the only lever on edge quality, and it is visibly rounder at this size.
 *
 * Generated once and committed -- the shape never changes.
 */
#define close_width 13
#define close_height 13
static unsigned char close_bits[] = {
  0xf0, 0x01, 0xf8, 0x03, 0xfc, 0x07, 0xfe, 0x0f,
  0xff, 0x1f, 0xff, 0x1f, 0xff, 0x1f, 0xff, 0x1f,
  0xff, 0x1f, 0xfe, 0x0f, 0xfc, 0x07, 0xf8, 0x03,
  0xf0, 0x01
};
