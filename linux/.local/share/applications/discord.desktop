[Desktop Entry]
# Override of the package entry: CUDA_VISIBLE_DEVICES= hides the NVIDIA GPU, so
# screenshare encodes in software instead of NVENC, which segfaulted the renderer.
Name=Discord
StartupWMClass=discord
Comment=All-in-one voice and text chat for gamers that's free, secure, and works on both your desktop and phone.
GenericName=Internet Messenger
Exec=env CUDA_VISIBLE_DEVICES= /usr/bin/discord --url -- %u
Icon=discord
Type=Application
Categories=Network;InstantMessaging;
MimeType=x-scheme-handler/discord;
Path=/usr/bin
