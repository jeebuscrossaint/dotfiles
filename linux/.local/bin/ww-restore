#!/bin/sh
# ww-restore — (re)draw the wallpaper.
#
# ww holds a wlr-layer-shell surface per output. Suspending destroys the output,
# which destroys that surface, and ww does not notice: both of the callbacks that
# would tell it are empty stubs in its own source --
#
#     src/wayland.cc:479  registry_global_remove()  { /* TODO: Handle output removal */ }
#     src/wayland.cc:251  layer_surface_closed()    { }
#
# so on resume the output is back with no wallpaper on it and ww is still running,
# happily holding a surface that no longer exists. Restarting it is the only fix
# that does not involve teaching ww output hotplug.
#
# This is the single place the wallpaper path lives -- dwl's autostart[] and
# swayidle's after-resume both come through here. Override with WW_WALLPAPER.
#
# ww never exits, so it MUST be backgrounded: swayidle runs with -w and waits for
# each command, and a daemon in after-resume would wedge the idle chain for the
# rest of the session.

WALL="${WW_WALLPAPER:-$HOME/jbwallpapers/wallpapers/Matanuska-River-ENBLA05.jpg}"
MODE="${WW_MODE:-fill}"

if [ ! -r "$WALL" ]; then
	echo "ww-restore: no readable wallpaper at $WALL" >&2
	exit 1
fi

# Only our own; -x so a path or an argument containing "ww" is not a match.
pkill -x ww 2>/dev/null

# Give the old instance a moment to drop its surfaces, or the new one can race it
# and end up drawing nothing.
i=0
while pgrep -x ww >/dev/null 2>&1 && [ "$i" -lt 20 ]; do
	sleep 0.1
	i=$((i + 1))
done

setsid ww -m "$MODE" "$WALL" >/dev/null 2>&1 &
