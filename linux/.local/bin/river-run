#!/bin/sh
# river-run — start a river session from a TTY.
#
# Deliberately thin. river has no compile-time config and no socket-handover
# patch, so there is nothing to wrap the way dwl-run had to wrap dwl: no
# wl-restart, no slstatus pipe (the bar is a separate client), no rebuild step.
# All this does is fix up the environment and hand over.
#
# Everything in here has to work on BOTH Artix and OpenBSD -- that is the whole
# point of this stack -- so anything Linux-only is gated on `uname`.

export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_TYPE=wayland

# Toolkits default to X11 under XWayland unless told otherwise.
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1

# Raise the fd limit before starting. sway does this for itself
# (increase_nofile_limit() in its main); river does not, and neither did dwl.
# Past the soft limit a wlroots compositor stays responsive but can no longer
# ACCEPT new client connections -- the compositor looks fine while nothing new
# will launch. 1024 is not a limit to run a desktop against.
hard=$(ulimit -Hn 2>/dev/null) || hard=""
case "$hard" in
unlimited) hard=65536 ;;
'' | *[!0-9]*) hard="" ;;
esac
[ -n "$hard" ] && ulimit -n "$hard" 2>/dev/null

# Keep stderr. From a TTY it scrolls away, and an overnight failure with no log
# is how a whole day went into guessing at a dwl bug that was never reproduced.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/river"
LOG="$LOG_DIR/river.log"
if mkdir -p "$LOG_DIR" 2>/dev/null; then
	[ -f "$LOG" ] && mv -f "$LOG" "$LOG.1" 2>/dev/null
	exec 2>>"$LOG"
	printf '=== session started %s on %s ===\n' "$(date '+%F %T')" "$(uname -s)" >&2
fi

exec river "$@"
