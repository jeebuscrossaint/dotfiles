#!/bin/sh
# menu-run — the application launcher.
#
# Spotlight, in the Quickshell shell (~/.config/quickshell/Launcher). The script
# is kept rather than binding the launcher directly so that all three compositor
# configs keep calling one stable name -- it was wmenu, then fuzzel, now this,
# and none of those swaps touched a keybind.
#
# fuzzel is still installed and is still what `menu` uses for the dmenu-style
# pickers (cliphist, theme-pick). Only the .desktop launcher moved.
#
# Reachability is `pgrep`, NOT the exit status of the call: `qs ipc call` exits 0
# even for a target that does not exist, so a dead shell would look like a
# successful launch and the fallback would never fire. That matters in a mango
# session, where nothing starts the shell.
if pgrep -x qs >/dev/null 2>&1; then
	exec qs ipc call spotlight toggle
fi

exec fuzzel "$@"
