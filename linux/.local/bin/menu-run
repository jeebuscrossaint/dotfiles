#!/bin/sh
# menu-run — the application launcher.
#
# Now a one-liner, and that is the whole reason for moving to fuzzel. What this script
# used to be: a loop over every directory in $PATH listing every executable file, piped
# into wmenu, because wmenu has no .desktop support. That offered up `[`, `zgrep`,
# `x86_64-pc-linux-gnu-gcc-ranlib` and several hundred other things nobody launches by
# hand, with no real names and no icons.
#
# fuzzel's default mode IS .desktop launching, with icons, the app's proper name, and
# its actions (so Firefox offers "New Private Window"). Nothing to reimplement.
#
# The script is kept rather than binding fuzzel directly so that all three compositor
# configs keep calling one stable name.
exec fuzzel "$@"
