#!/bin/sh
# menu-run — the application launcher.
#
# Spotlight, in the Quickshell shell (~/.config/quickshell/Launcher). The script
# is kept rather than binding the launcher directly so that all three compositor
# configs keep calling one stable name -- it was wmenu, then fuzzel, now this,
# and none of those swaps touched a keybind.
#
# fuzzel is back as the fallback, because the mango session starts no shell and
# a launcher that only errors is not a launcher. Spotlight when the shell is
# there, fuzzel when it is not -- one keybind, either session.
#
# The test is `pgrep`, NOT the exit status of the call: `qs ipc call` exits 0 even
# for a target that does not exist, so a dead shell would look like a success and
# the fallback would never fire.
if pgrep -x qs >/dev/null 2>&1; then
	exec qs ipc call spotlight toggle
fi

exec fuzzel
