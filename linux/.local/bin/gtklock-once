#!/bin/sh
# Single-instance gtklock. Replaces swaylock-once (2026-08-05).
#
# swayidle can ask for a lock from more than one event for a single lid close
# (before-sleep fires on the way down, and the idle timeout that accumulated
# while suspended fires on the way back up). Stacking a second lock surface
# means you unlock, see the desktop for a beat, and get prompted again. Bail out
# if one is already up.
#
# -d matters as much as the guard: swayidle runs with -w, so it waits for the
# command to exit. Without -d, gtklock never exits until you type your password,
# which blocks swayidle for the whole suspend and leaves it to replay the stale
# idle timeout the moment you unlock. (swaylock spelled this -f; gtklock's -f is
# --follow-focus, so do not copy the old flag across.)
#
# Everything visual is in ~/.config/gtklock/style.css -> coat-theme.css, and
# behaviour is in ~/.config/gtklock/config.ini, which gtklock reads on its own.
pgrep -x gtklock >/dev/null 2>&1 && exit 0
exec gtklock -d "$@"
