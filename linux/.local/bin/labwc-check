#!/bin/sh
# labwc-check — validate ~/.config/labwc/rc.xml and menu.xml before starting a
# session.
#
# labwc has no dry-run flag, which is the gap this fills. Unlike `mango -p` it can
# only prove the XML is well-formed: labwc does not validate action or option NAMES
# up front, it logs an unknown one and carries on. So a green result here means
# "labwc will start and read the file", not "every bind works".
#
# Exits 0 if everything parses, 1 otherwise. Safe to run outside a session.

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/labwc"
status=0

command -v xmllint >/dev/null 2>&1 || {
	echo "labwc-check: xmllint not found (install libxml2)" >&2
	exit 1
}

for f in rc.xml menu.xml; do
	path="$CONF/$f"
	# menu.xml is optional -- labwc falls back to its built-in root menu.
	if [ ! -f "$path" ]; then
		[ "$f" = "rc.xml" ] && { echo "MISSING  $path" >&2; status=1; }
		continue
	fi
	if err=$(xmllint --noout "$path" 2>&1); then
		echo "ok       $f"
	else
		echo "FAILED   $f" >&2
		echo "$err" >&2
		status=1
	fi
done

# Cheap sanity net for the class of mistake xmllint cannot see: an Execute action
# pointing at a program that is not installed. Every one of these was a silently
# dead keybind in the version of this config that sat in git history.
if [ -f "$CONF/rc.xml" ]; then
	missing=""
	for cmd in $(sed -n 's/.*command="\([^ "]*\).*/\1/p' "$CONF/rc.xml" | sort -u); do
		case "$cmd" in
		sh | pkill) continue ;;
		esac
		command -v "$cmd" >/dev/null 2>&1 || missing="$missing $cmd"
	done
	if [ -n "$missing" ]; then
		echo "WARNING  keybinds point at programs not on PATH:$missing" >&2
		status=1
	else
		echo "ok       every Execute target is on PATH"
	fi
fi

exit $status
