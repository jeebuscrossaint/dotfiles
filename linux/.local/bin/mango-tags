#!/bin/sh
# mango-tags — stream mango's tag state for waybar's custom module.
#
# mango is dwl-derived but does NOT implement dwl's IPC protocol (its protocols/
# directory has only layer-shell, foreign-toplevel and output-power-management),
# so waybar's `dwl/tags` module cannot see it. mango has its own IPC instead, via
# `mmsg`, and `mmsg watch all-tags` streams state changes -- which is exactly
# what a waybar custom module in continuous mode consumes.
#
# Output is one line per update: the tag row, with the focused tag marked. waybar
# renders it via a custom/mangotags module with "return-type": "" (plain text).
#
# Tag glyph meaning:
#   accent + underline  focused
#   solid               has windows
#   dim                 empty

FOCUS_COLOR="#20bcfc"   # base0D
USED_COLOR="#d0d0d0"    # base05
EMPTY_COLOR="#747474"   # base03

command -v mmsg >/dev/null 2>&1 || {
	echo "mmsg missing"
	exit 1
}

render() {
	# mmsg prints key: value lines per tag; collect what we need and emit a row.
	# Fields vary by mango version, so parse defensively: anything we cannot
	# read degrades to an empty tag rather than breaking the bar.
	awk -v fc="$FOCUS_COLOR" -v uc="$USED_COLOR" -v ec="$EMPTY_COLOR" '
	function flush_tag() {
		if (id == "") return
		color = ec
		if (clients + 0 > 0) color = uc
		if (focused == "1" || focused == "true") color = fc
		out = out sprintf("<span color=\"%s\">%s</span> ", color, id)
		id = ""; clients = 0; focused = ""
	}
	/^[[:space:]]*(tag|index)[[:space:]]*:/ { flush_tag(); split($0, a, ":"); gsub(/[[:space:]]/, "", a[2]); id = a[2]; next }
	/^[[:space:]]*(clients|num_clients|windows)[[:space:]]*:/ { split($0, a, ":"); gsub(/[[:space:]]/, "", a[2]); clients = a[2]; next }
	/^[[:space:]]*(focused|is_focused|selected)[[:space:]]*:/ { split($0, a, ":"); gsub(/[[:space:]]/, "", a[2]); focused = a[2]; next }
	/^[[:space:]]*$/ { next }
	END { flush_tag(); sub(/ $/, "", out); print out; fflush() }
	'
}

# `watch` emits a fresh block per change. Blocks are separated by blank lines in
# mmsg's output, so accumulate until one ends, then render that block.
buf=""
mmsg watch all-tags 2>/dev/null | while IFS= read -r line; do
	case "$line" in
	'')
		[ -n "$buf" ] && printf '%s\n' "$buf" | render
		buf=""
		;;
	*)
		buf="$buf$line
"
		;;
	esac
done
