#!/usr/bin/env python3
"""mango-tags — stream mango's tag row for waybar's custom module.

waybar has no mango module, and mango is dwl-derived but does NOT implement dwl's
IPC protocol (its protocols/ dir carries only layer-shell, foreign-toplevel and
output-power-management), so `dwl/tags` cannot see it either. mango has its own
IPC via `mmsg`, and `mmsg watch all-tags` streams one JSON object per change --
which is exactly what a waybar custom module in continuous mode consumes.

`mmsg` emits JSON, one complete object per line:

    {"all_tags":[{"monitor":"eDP-1","tags":[{"index":1,"is_active":false,
     "is_urgent":false,"layout":"T","client_count":6}, ...]}]}

Colour is inline pango markup because waybar cannot style individual characters
inside a custom module's text -- the CSS can only reach the module as a whole.

Output is one line per update, flushed immediately, so the bar updates the moment
a tag does rather than on a poll interval.
"""

import json
import os
import shutil
import signal
import subprocess
import sys


def coat_colors():
    """Read the palette out of coat's mango fragment.

    These are pango markup, not CSS, so coat cannot reach them the way it reaches
    a stylesheet -- waybar cannot style individual characters inside a custom
    module, which is why the colour is inline in the first place. Rather than add
    another coat module for two scripts, reuse the fragment coat already writes
    for the compositor: ~/.config/mango/coat-colors.conf, lines of the form
    `focuscolor=0xRRGGBBAA`.

    Falls back to Framer if the file is missing, so this still runs on a machine
    where coat has never been applied.
    """
    out = {
        "focused": "#20bcfc",
        "occupied": "#d0d0d0",
        "empty": "#747474",
        "urgent": "#fd886b",
    }
    # scratchpadcolor is base0D (the accent), focuscolor base05, bordercolor
    # base03, urgentcolor base08 -- see coat's templates/mango.tera.
    keymap = {
        "scratchpadcolor": "focused",
        "focuscolor": "occupied",
        "bordercolor": "empty",
        "urgentcolor": "urgent",
    }
    path = os.path.expanduser("~/.config/mango/coat-colors.conf")
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if "=" not in line or line.startswith("#"):
                    continue
                key, _, val = line.partition("=")
                slot = keymap.get(key.strip())
                if not slot:
                    continue
                val = val.strip()
                if val.startswith("0x") and len(val) >= 8:
                    # 0xRRGGBBAA -> #RRGGBB; pango wants no alpha channel.
                    out[slot] = "#" + val[2:8]
    except OSError:
        pass
    return out



COLORS = coat_colors()
FOCUSED = COLORS["focused"]
OCCUPIED = COLORS["occupied"]
EMPTY = COLORS["empty"]
URGENT = COLORS["urgent"]


def render(payload):
    """Turn one all-tags object into a pango-marked row."""
    out = []
    for mon in payload.get("all_tags", []):
        for tag in mon.get("tags", []):
            idx = tag.get("index")
            if idx is None:
                continue
            if tag.get("is_urgent"):
                color = URGENT
            elif tag.get("is_active"):
                color = FOCUSED
            elif tag.get("client_count", 0) > 0:
                color = OCCUPIED
            else:
                # Empty and unfocused: skip entirely rather than print a dim
                # number. Nine placeholders is most of the row for no
                # information, and dwm-style bars have always hidden them.
                continue
            out.append(f'<span color="{color}">{idx}</span>')
        # Only the first monitor: waybar runs one bar per output and this module
        # would otherwise repeat every output's tags on each of them.
        break
    return " ".join(out)


def main():
    # Not under mango (a labwc session, say): print one blank line so waybar renders
    # an empty module, then block forever.
    #
    # Blocking rather than returning is the point. Without the guard at all, the
    # missing `mmsg` raises FileNotFoundError and the script dies; but returning
    # cleanly is barely better, because waybar's restart-interval respawns a custom
    # module whenever it EXITS, whatever the status -- so either way waybar pays a
    # Python startup every 5 seconds for the whole session. signal.pause() costs
    # nothing and leaves the module quietly empty.
    if shutil.which("mmsg") is None:
        print("", flush=True)
        signal.pause()
        return 0

    proc = subprocess.Popen(
        ["mmsg", "watch", "all-tags"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    if proc.stdout is None:
        return 1
    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue
        try:
            payload = json.loads(line)
        except json.JSONDecodeError:
            # A partial or unexpected line must not kill the module -- waybar
            # would show a permanently empty slot until the next restart.
            continue
        print(render(payload), flush=True)
    return proc.wait()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
