#!/bin/sh
# Run one process on the RTX 4070.
#
# In Hybrid MUX nothing should instantiate the NVIDIA device unless it is asked
# to, so RTD3 can park the card -- anything that actually wants the dGPU flips
# the loaders over here.
#
# Hyprland used to PIN the loaders to Mesa+Intel session-wide (hyprland.lua) and
# this script existed to undo that per-process. Those pins went with Hyprland and
# mango sets none, so the defaults are doing the work now: check
# /sys/bus/pci/devices/0000:01:00.0/power_state is still D3cold on an idle
# desktop before assuming that is good enough.
# In Discrete MUX the compositor sets no such pins and NVIDIA is already
# primary; re-asserting them is harmless.
if [ -d /sys/module/nvidia_drm ]; then
    [ -f /usr/share/glvnd/egl_vendor.d/10_nvidia.json ] && \
        export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
    [ -f /usr/share/vulkan/icd.d/nvidia_icd.json ] && \
        export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.json
    export __GLX_VENDOR_LIBRARY_NAME=nvidia

    # Only meaningful in Hybrid; inert once the dGPU is the scanout engine.
    export __NV_PRIME_RENDER_OFFLOAD=1
    export __NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0
    export __VK_LAYER_NV_optimus=NVIDIA_only

    # 1.8.9 submits GL from a single thread; this moves driver work off it.
    # Measured 57% -> 95% GPU utilisation in Minecraft 1.8.9.
    export __GL_THREADED_OPTIMIZATIONS=1
    export __GL_SYNC_TO_VBLANK=0
    export __GL_MaxFramesAllowed=1
fi
exec "$@"
