#!/bin/sh
# lock — engage the screen lock.
#
# Kept as a script for its one guard, not for indirection: the wlr session-lock
# protocol allows exactly ONE lock client, so a manual lock landing on top of an
# idle lock used to stack two password prompts. idle-guard, swayidle's
# before-sleep and the Super+L bind all come through here so they cannot disagree.
set -u

pgrep -x hyprlock >/dev/null 2>&1 && exit 0
exec hyprlock
