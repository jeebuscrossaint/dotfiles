#!/bin/sh
# Keep swayosd-server alive for the whole sway session.
#
# Every volume/brightness/lock key in sway's config goes through
# swayosd-client, which talks to swayosd-server over DBus. With no server the
# client fails silently -- keys do nothing at all, which feels exactly like the
# audio dying. sway's `exec` fires only at session start, so a server that dies
# mid-session stayed dead until the next login.
#
# The 1s delay is load-bearing in two directions: it stops a server that fails
# instantly from spinning, and it has to stay SHORTER than the 2s grace period
# in coat's swayosd theme hook (src/modules.rs, apply_swayosd). That hook kills
# the server to reload its stylesheet, then waits and only starts a replacement
# if nothing came back. This loop wins that race, the hook sees a live server
# and backs off, and we never end up with two servers fighting over the DBus
# name.
while :; do
    swayosd-server
    sleep 1
done
