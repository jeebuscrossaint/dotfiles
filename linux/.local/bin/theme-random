#!/usr/bin/env bash
# Pick a random coat scheme, apply it everywhere, and notify. (mango: Super+Shift+T)
# coat reloads every enabled module itself -- under mango that includes an
# `mmsg dispatch reload_config`, so the compositor recolours without a restart.
coat random -y >/dev/null 2>&1
# The family is reported because ~46 slugs exist in both, so the name alone does
# not tell you which palette you are looking at. Both come from coat's state
# file -- the scheme in use is not in coat.yaml, which is a checked-in config and
# only holds the seed a fresh checkout starts from.
state="${XDG_STATE_HOME:-$HOME/.local/state}/coat/state.yaml"
scheme=$(awk '$1=="scheme:"{print $2}' "$state" 2>/dev/null)
fam=base16
grep -q '^base24: *true' "$state" 2>/dev/null && fam=base24
command -v notify-send >/dev/null &&
	notify-send -t 2000 "󰏘  Theme" "switched to $scheme ($fam)"
