#!/bin/sh
# awww — the wallpaper daemon's CLI, wrapped so the colours follow the wallpaper.
#
# `awww img ...` sets the wallpaper and then re-runs `coat match`, but ONLY when
# the scheme in use is one coat generated from a wallpaper. Pin a real scheme and
# nothing here fires:
#
#   coat match          from now on, wallpapers retheme the desktop
#   coat set chalk      from now on, they do not
#
# The rule is not a flag to remember, it is just what the current scheme IS: a
# generated scheme lives in schemes/generated/, a chosen one does not.
#
#   COAT_FOLLOW=0 awww img x.png    set the wallpaper, leave the theme alone
#   COAT_FOLLOW=1 awww img x.png    retheme even from a hand-picked scheme
#
# Everything that is not `img` is handed straight through, `restore` included:
# that runs at login with the wallpaper already themed, and a retheme there would
# restart waybar and fnott for no reason every time you log in.

COAT_YAML="${XDG_CONFIG_HOME:-$HOME/.config}/coat/coat.yaml"
GENERATED="${XDG_CONFIG_HOME:-$HOME/.config}/coat/schemes/generated"

# The real binary: the first awww on PATH that is not this script. Resolved
# rather than hardcoded to /usr/bin so a cargo-installed or packaged awww both
# work -- and so this cannot recurse into itself if either moves.
self=$(readlink -f "$0" 2>/dev/null || echo "$0")
real=''
old_ifs=$IFS
IFS=:
for dir in $PATH; do
	candidate="$dir/awww"
	[ -x "$candidate" ] || continue
	resolved=$(readlink -f "$candidate" 2>/dev/null || echo "$candidate")
	[ "$resolved" = "$self" ] && continue
	real=$candidate
	break
done
IFS=$old_ifs

if [ -z "$real" ]; then
	echo "awww: the real awww is not on PATH (this is the theming wrapper)" >&2
	exit 127
fi

"$real" "$@" || exit $?

[ "$1" = img ] || exit 0

# Hand the greeter a copy it can actually read.
#
# greetd runs the login screen as the `greeter` user and $HOME is mode 700, so
# nothing under ~/jbwallpapers is reachable from there -- not even with the file
# itself world-readable, because traversal needs +x on every parent. A drop
# directory outside $HOME is the way round it, owned by this user so no sudo is
# needed on every wallpaper change.
#
# The extension is preserved: Qt picks the image format from it, and a file
# called plain "wallpaper" fails to load. Older copies are cleared so a jpg
# never lingers behind a png.
#
# Silent no-op when the directory does not exist, which is the case until the
# greeter is installed. Create it with:
#   sudo install -d -o "$USER" -g "$USER" /var/lib/greeter
GREETER_DIR=/var/lib/greeter
if [ -d "$GREETER_DIR" ] && [ -w "$GREETER_DIR" ]; then
	for arg in "$@"; do
		case "$arg" in
		/*.jpg | /*.jpeg | /*.png | /*.webp)
			rm -f "$GREETER_DIR"/wallpaper.*
			cp -f "$arg" "$GREETER_DIR/wallpaper.${arg##*.}" 2>/dev/null
			break
			;;
		esac
	done
fi
[ "$COAT_FOLLOW" = 0 ] && exit 0
command -v coat >/dev/null 2>&1 || exit 0

scheme=$(sed -n 's/^scheme:[[:space:]]*//p' "$COAT_YAML" 2>/dev/null | head -1 | tr -d '"')

if [ "$COAT_FOLLOW" != 1 ] && [ ! -f "$GENERATED/$scheme.yaml" ]; then
	exit 0
fi

# Keep whatever flavour the current scheme was generated with -- the slug records
# it, so following the wallpaper does not silently switch you from --slots back
# to the default, or from a light scheme to a dark one.
flags=''
case "$scheme" in
*-slots*) flags="$flags --slots" ;;
esac
case "$scheme" in
*-light) flags="$flags --light" ;;
esac

# shellcheck disable=SC2086 # flags is a deliberate word-split, and never a path.
exec coat match $flags
