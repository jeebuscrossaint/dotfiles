#!/bin/sh
# auto-refresh — ProMotion-style refresh switching for the eDP OLED: 240Hz on
# AC, 60Hz on battery. Started from the compositor's exec-once.
#
# Measured at 15.3W -> 13.7W (~1.6W) back when the MUX was in Hybrid and the
# dGPU was asleep. That figure does NOT transfer to Discrete mode: with the
# 4070 driving the panel its own draw swings several watts on workload alone,
# which is more than the effect, so the saving there is real but unmeasured.
#
# `hyprctl keyword` does NOT work here -- the config is Lua, and the non-legacy
# parser rejects it with "keyword can't work with non-legacy parsers. Use eval."
# while still exiting 0, so a keyword-based version fails completely silently.
# Same trap as the hyprbars button actions: it has to be a Lua-form call.
#
# Compares against the CURRENT mode rather than caching the last AC state. The
# cached version got stranded by `hyprctl reload` (SUPER+SHIFT+C), which resets
# eDP-1 to the config's 240Hz while the cache still said "battery, already
# handled" -- so the panel sat at 240Hz on battery until AC was toggled. This
# way any reset is corrected on the next poll.
AC=/sys/class/power_supply/ACAD/online

# The mode line reads "\t2560x1600@240.00101 at 0x0"; take the integer part.
current_hz() {
	hyprctl monitors 2>/dev/null | awk '
		/^Monitor eDP-1 /{ f = 1; next }
		f && /@/ { split($1, a, "@"); printf "%d", a[2]; exit }
	'
}

while :; do
	if [ "$(cat "$AC" 2>/dev/null)" = "1" ]; then want=240; else want=60; fi
	if [ "$(current_hz)" != "$want" ]; then
		hyprctl eval "hl.monitor({ output = \"eDP-1\", mode = \"2560x1600@${want}\", position = \"0x0\", scale = 1, bitdepth = 10 })" >/dev/null 2>&1
	fi
	sleep 10
done
