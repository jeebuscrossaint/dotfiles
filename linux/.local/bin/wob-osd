#!/bin/sh
# wob-osd — supervise wob for the volume/brightness OSD.
#
# wob reads its config ONCE at startup, so a coat scheme change means restarting
# it. That is the whole reason this exists, and it is fiddlier than it looks:
#
#   `tail -f fifo | wob` is the canonical way to run wob, because wob exits the
#   moment its stdin closes ("STDIN unexpectedly closed") and tail keeps the write
#   end open. But if you kill only wob, tail does NOT die -- it is blocked reading
#   the FIFO and only discovers the broken pipe when it next writes. So the
#   pipeline hangs half-dead with no wob, and the OSD stays gone until the next
#   volume keypress happens to push a byte through. Killing wob is not enough;
#   the whole pipeline has to go.
#
# Hence: the pipeline runs in its own process group (setsid) so it can be killed
# as a unit, and coat asks for a restart with SIGUSR1 rather than trying to guess
# process names. Signals beat `pkill -f` patterns here -- a -f pattern matches any
# command line that merely mentions it, including the shell that coat spawns to
# run the pkill, which then kills itself.
#
# Without a supervisor at all, a dead wob stays dead for the session. That is
# exactly how swayosd used to fail: silently, with every media key still changing
# the volume but nothing appearing on screen.

FIFO="${XDG_RUNTIME_DIR:-/tmp}/wob.sock"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/wob-osd.pid"

command -v wob >/dev/null 2>&1 || {
	echo "wob-osd: wob is not installed" >&2
	exit 1
}

# Only one supervisor: two would race for reads off the same FIFO and each value
# would land in whichever woke first.
#
# A pidfile, NOT `pgrep -f wob-osd`: -f matches whole command lines, so the shell
# that launched this script counts as an instance and the guard refuses to start.
# `pgrep -x` is no good either -- the process name is the interpreter, not the
# script. kill -0 against a recorded pid is exact, and behaves the same on OpenBSD.
if [ -r "$LOCK" ]; then
	read -r oldpid <"$LOCK" 2>/dev/null
	case "$oldpid" in
	'' | *[!0-9]*) ;;
	*)
		if kill -0 "$oldpid" 2>/dev/null; then
			echo "wob-osd: already running as $oldpid" >&2
			exit 0
		fi
		;;
	esac
fi
printf '%s\n' "$$" >"$LOCK"

[ -p "$FIFO" ] || { rm -f "$FIFO"; mkfifo -m 600 "$FIFO"; }

group=""

# Kill the pipeline as a group. The leading '-' makes kill target the process
# group, which is why spawn() uses setsid: without its own group there is no way
# to take tail and wob down together.
stop_pipeline() {
	[ -n "$group" ] && kill -- "-$group" 2>/dev/null
	group=""
}

spawn_pipeline() {
	setsid sh -c 'tail -f "$1" | wob' _ "$FIFO" &
	group=$!
}

# SIGUSR1 = "config changed, restart wob". coat's wob module sends this.
trap 'stop_pipeline' USR1
trap 'stop_pipeline; rm -f "$FIFO" "$LOCK"; exit 0' TERM INT

while :; do
	spawn_pipeline
	# `wait` is interrupted by the USR1 trap, which is what makes a restart
	# immediate rather than waiting for the pipeline to notice anything.
	wait "$group" 2>/dev/null
	stop_pipeline
	# A brief pause so a persistently failing wob cannot become a spin loop.
	sleep 1
done
