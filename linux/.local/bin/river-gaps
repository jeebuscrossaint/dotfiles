#!/bin/sh
# river-gaps — change rivertile's padding live.
#
# rivertile takes -view-padding and -outer-padding as STARTUP flags only; its
# runtime protocol (riverctl send-layout-cmd) understands nothing but
# main-location, main-count and main-ratio. So the only way to change gaps
# without editing the config is to restart the generator with new numbers, which
# is instant and does not disturb any window.
#
# Usage: river-gaps +1 | -1 | reset | toggle | <n>
#
# State lives in a file because rivertile does not report its own padding back.

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/river/gaps"
DEFAULT=8
RATIO=0.55

mkdir -p "$(dirname "$STATE")" 2>/dev/null

read_gaps() {
	if [ -r "$STATE" ]; then
		read -r g <"$STATE" 2>/dev/null
		case "$g" in
		'' | *[!0-9]*) echo "$DEFAULT" ;;
		*) echo "$g" ;;
		esac
	else
		echo "$DEFAULT"
	fi
}

cur=$(read_gaps)

case "${1:-}" in
+*) new=$((cur + ${1#+})) ;;
-*) new=$((cur - ${1#-})) ;;
reset) new=$DEFAULT ;;
toggle) if [ "$cur" -eq 0 ]; then new=$DEFAULT; else new=0; fi ;;
'') echo "usage: river-gaps +1 | -1 | reset | toggle | <n>" >&2; exit 2 ;;
*[!0-9]*) echo "river-gaps: not a number: $1" >&2; exit 2 ;;
*) new=$1 ;;
esac

[ "$new" -lt 0 ] && new=0
printf '%s\n' "$new" >"$STATE"

# Preserve the current main-location and main-count across the restart: they are
# rivertile state, and restarting it would otherwise silently reset them to the
# defaults. There is no way to query them, so they are tracked alongside gaps by
# whatever set them; absent that, fall back to the config's defaults.
LOC="left"
[ -r "${STATE%gaps}main-location" ] && read -r LOC <"${STATE%gaps}main-location"

pkill -x rivertile 2>/dev/null
# Give river a moment to notice the layout is gone, or the new one can race the
# old one's exit and river ends up with no layout at all.
i=0
while pgrep -x rivertile >/dev/null 2>&1 && [ "$i" -lt 20 ]; do
	sleep 0.05
	i=$((i + 1))
done

setsid rivertile -view-padding "$new" -outer-padding "$new" \
	-main-location "$LOC" -main-ratio "$RATIO" >/dev/null 2>&1 &

# rivertile registers itself under its own namespace; re-assert it as the default
# in case river had fallen back while nothing was running.
sleep 0.2
riverctl default-layout rivertile 2>/dev/null
