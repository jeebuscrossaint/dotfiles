#!/bin/sh
# dwl-run — start a dwl session from a TTY.
#
# The bar patch reads its status text from dwl's OWN stdin, one line per update,
# so slstatus is piped in rather than started from dwl's autostart[] array. That
# is also why this is a script and not just `exec dwl`.
#
# wl-restart keeps the Wayland socket alive across a dwl crash (the
# wayland-socket-handover patch reads WAYLAND_SOCKET_NAME/WAYLAND_SOCKET_FD,
# which is what --env sets) and brings dwl straight back instead of dropping you
# to a TTY.
#
# Note on what that does and does not save: the SOCKET survives, but a client
# only survives if it can reconnect to a restarted compositor, and in practice
# only Qt6 does (with QT_WAYLAND_RECONNECT=1, set below). Firefox, foot, and
# anything GTK or Electron still die. So this is crash recovery, not a free
# restart -- editing config.h still costs you your windows.
#
# The whole pipeline is wrapped rather than just dwl: slstatus holds the write
# end of the pipe, so if dwl alone were restarted slstatus would take SIGPIPE
# the moment dwl died and the restarted dwl would read EOF -- a bar with no
# status. Restarting the pipeline gives each dwl a fresh slstatus.
#
# XDG_CURRENT_DESKTOP matters for the portal: xdg-desktop-portal picks a backend
# by matching this against the portal's UseIn= field, and the wlr backend
# advertises wlroots. Getting it wrong is the usual cause of a screenshare
# picker that never appears.

export XDG_CURRENT_DESKTOP=wlroots
export XDG_SESSION_TYPE=wayland

# Qt/GTK/Firefox all default to X11 under XWayland unless told otherwise.
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1

# The one toolkit that can reattach to a restarted compositor.
export QT_WAYLAND_RECONNECT=1

# dwl inherits this process's environment; dbus-update-activation-environment in
# autostart[] then hands it to anything dbus launches later.

# Raise the file-descriptor limit. sway did this for itself (increase_nofile_limit()
# in its main()); dwl never has, so it ran on the 1024 soft limit. A wlroots
# compositor spends fds freely -- one per client connection, per dmabuf, per shm
# pool, per input device -- and a fresh session here already sits around 164. When
# the limit is reached the compositor stays up and responsive but can no longer
# ACCEPT new client connections, so every spawn bind silently does nothing while
# tag switching and quit keep working.
hard=$(ulimit -Hn 2>/dev/null) || hard=""
case "$hard" in
unlimited) hard=65536 ;;
'' | *[!0-9]*) hard="" ;;
esac
[ -n "$hard" ] && ulimit -n "$hard" 2>/dev/null

# Keep dwl's stderr. Started from a TTY it scrolls away, so a crash or a rejected
# output commit leaves nothing to read afterwards -- which is why an overnight
# breakage could not be diagnosed. One previous session is kept alongside.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dwl"
LOG="$LOG_DIR/dwl.log"
if mkdir -p "$LOG_DIR" 2>/dev/null; then
	[ -f "$LOG" ] && mv -f "$LOG" "$LOG.1" 2>/dev/null
	# Both dwl and wl-restart inherit this, and so does slstatus.
	exec 2>>"$LOG"
	printf '=== session started %s ===\n' "$(date '+%F %T')" >&2
fi

if command -v wl-restart >/dev/null 2>&1; then
	exec wl-restart --env -- sh -c 'slstatus -s | dwl "$@"' dwl-run "$@"
else
	exec sh -c 'slstatus -s | dwl "$@"' dwl-run "$@"
fi
