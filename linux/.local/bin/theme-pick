#!/usr/bin/env bash
# Picker over all coat schemes; apply the choice everywhere + notify.
#
# `menu`, not fuzzel directly: menu is the dmenu wrapper every caller here uses,
# so the launcher underneath can be swapped without editing this.
#
# Entries are tagged `[base24]` because ~46 slugs exist in BOTH families and coat
# lists them under the same name -- the picker showed two identical rows with no
# way to tell them apart. coat has no per-invocation flag for this: `coat set`
# takes a slug and nothing else, and the family is decided by prefer_base24 in
# coat.yaml. So the tag is not decoration, it is what the script writes back to
# that key before applying.
set -u
conf="$HOME/.config/coat/coat.yaml"

# Pair each scheme's name line (which carries the [Base24] marker) with the
# `Slug:` line that follows it. Parsing only Slug: lines is what dropped the
# marker in the first place. sed strips coat's ANSI bold.
pick=$(coat list --no-preview 2>/dev/null \
  | sed 's/\x1b\[[0-9;]*m//g' \
  | awk '
      /^[^ ]/ && !/^Found/ && !/^Author:/ { b24 = /\[Base24\]/ ? " [base24]" : "" }
      /Slug:/ { print $2 b24 }
    ' \
  | menu -i -p theme)
[ -n "$pick" ] || exit 0

slug=${pick% \[base24\]}
case "$pick" in
*"[base24]") want=true ;;
*) want=false ;;
esac

# prefer_base24 has to be right BEFORE coat set runs, or coat resolves the slug
# to the other family and the pick silently does nothing.
if grep -q '^prefer_base24:' "$conf"; then
	sed -i "s/^prefer_base24:.*/prefer_base24: $want/" "$conf"
fi

coat set "$slug" >/dev/null 2>&1
fam=$([ "$want" = true ] && echo base24 || echo base16)
command -v notify-send >/dev/null &&
	notify-send -t 2000 "󰏘  Theme" "switched to $slug ($fam)"
