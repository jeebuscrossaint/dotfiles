#!/usr/bin/env bash
# Picker over all coat schemes; apply the choice everywhere + notify.
#
# fuzzel directly. This was the last caller of the `menu` wrapper, and that
# wrapper was a branch between fuzzel and a shell that no longer exists.
#
# Entries are tagged `[base24]` because ~46 slugs exist in BOTH families and coat
# lists them under the same name -- the picker showed two identical rows with no
# way to tell them apart. The tag is not decoration: it becomes the --base16 or
# --base24 flag on the `coat set` below, which is how the pick reaches the family
# you actually clicked. This script used to sed prefer_base24 into coat.yaml
# first instead -- editing a config file in a dotfiles repo, mid-keypress, to
# pass one argument.
set -u

# Pair each scheme's name line (which carries the [Base24] marker) with the
# `Slug:` line that follows it. Parsing only Slug: lines is what dropped the
# marker in the first place. sed strips coat's ANSI bold.
pick=$(coat list --no-preview 2>/dev/null \
  | sed 's/\x1b\[[0-9;]*m//g' \
  | awk '
      /^[^ ]/ && !/^Found/ && !/^Author:/ { b24 = /\[Base24\]/ ? " [base24]" : "" }
      /Slug:/ { print $2 b24 }
    ' \
  | fuzzel --dmenu --prompt "theme ")
[ -n "$pick" ] || exit 0

slug=${pick% \[base24\]}
case "$pick" in
*"[base24]") fam=base24 ;;
*) fam=base16 ;;
esac

coat set "$slug" "--$fam" >/dev/null 2>&1
command -v notify-send >/dev/null &&
	notify-send -t 2000 "󰏘  Theme" "switched to $slug ($fam)"
