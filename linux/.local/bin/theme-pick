#!/usr/bin/env bash
# wmenu picker over all coat schemes; apply the choice everywhere + notify.
#
# wmenu, not tofi: tofi is not in OpenBSD ports and wmenu is, and wmenu is the
# launcher everywhere else in this setup now. coat applies the scheme to every
# enabled module itself -- under mango that includes a live `mmsg dispatch
# reload_config`, so the compositor recolours without a restart.
pick=$(coat list --no-preview 2>/dev/null | awk '/Slug:/{print $2}' | wmenu -i -p 'theme')
[ -n "$pick" ] || exit 0
coat set "$pick" >/dev/null 2>&1
command -v notify-send >/dev/null && notify-send -t 2000 "󰏘  Theme" "switched to $pick"
