#!/bin/sh
# mango-run — start a mango session from a TTY.
#
# Thin on purpose: config.conf owns the environment and the autostart, so all
# that is left is what has to happen BEFORE the compositor exists.

# Raise the fd limit. sway does this for itself; mango does not, so it inherits
# the 1024 soft limit -- past which it stays responsive but can no longer ACCEPT
# clients: the session looks healthy while nothing new will launch.
hard=$(ulimit -Hn 2>/dev/null) || hard=""
case "$hard" in
unlimited) hard=65536 ;;
'' | *[!0-9]*) hard="" ;;
esac
[ -n "$hard" ] && ulimit -n "$hard" 2>/dev/null

# Keep stderr; from a TTY it scrolls away and a crash leaves nothing to read.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mango"
LOG="$LOG_DIR/mango.log"
if mkdir -p "$LOG_DIR" 2>/dev/null; then
	[ -f "$LOG" ] && mv -f "$LOG" "$LOG.1" 2>/dev/null
	exec 2>>"$LOG"
	printf '=== session started %s on %s ===\n' "$(date '+%F %T')" "$(uname -s)" >&2
fi

# `mango -p` parses and exits, so a typo costs a clear error instead of a black
# screen and a walk back to the TTY.
if ! mango -c "$HOME/.config/mango/config.conf" -p >/dev/null 2>&1; then
	echo "mango-run: config rejected, not starting. Full output:" >&2
	mango -c "$HOME/.config/mango/config.conf" -p >&2 2>&1
	echo "mango-run: fix ~/.config/mango/config.conf and try again." >&2
	exit 1
fi

# ONE D-Bus session bus for the whole session. Artix has no systemd to create
# $XDG_RUNTIME_DIR/bus, so without this every client autolaunched its OWN bus --
# fnott listening on one, notify-send talking to another, notifications
# "randomly" dead with no error anywhere. This is also what makes the
# dbus-update-activation-environment line in config.conf mean anything.
if command -v dbus-run-session >/dev/null 2>&1; then
	exec dbus-run-session -- mango "$@"
fi

echo "mango-run: dbus-run-session not found; starting without a session bus." >&2
echo "mango-run: expect notifications and portals to misbehave." >&2
exec mango "$@"
