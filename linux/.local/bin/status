#!/bin/sh
# status — the bar, on demand, as one notification.
#
# There is no bar in the mango session. Everything waybar showed continuously is
# gathered here and drawn once, on Super+S, by the notification daemon. Same
# trade `osd` already makes for volume and brightness: no second daemon to
# theme, nothing to restart when coat changes the colours, and nothing on screen
# when you are not looking at it.
#
# The sources are the ones waybar itself read, so the numbers agree with what
# the bar used to say. hwmon is resolved by NAME, never by index -- numbering is
# assigned in probe order and moves across boots, which is the bug that makes a
# hardcoded hwmon5 quietly report somebody else's sensor.

set -u

RUN="${XDG_RUNTIME_DIR:-/tmp}"

# --- helpers -----------------------------------------------------------------

# hwmon <name> <file> — read one sysfs value from the hwmon of that name.
hwmon() {
	for h in /sys/class/hwmon/hwmon*; do
		[ -r "$h/name" ] || continue
		read -r n <"$h/name" 2>/dev/null
		[ "$n" = "$1" ] || continue
		[ -r "$h/$2" ] || continue
		read -r v <"$h/$2" 2>/dev/null
		printf '%s\n' "$v"
		return 0
	done
	return 1
}

# The panel's backlight is not a stable name: which card drives eDP is set by the
# BIOS MUX, so it is intel_backlight in Hybrid and nvidia_0 in Discrete, with the
# other absent rather than present-but-dead. A "raw" device is the real panel
# control; acpi_video0 is a firmware shim that is often present and often inert,
# so raw wins and anything else is the fallback.
backlight_dev() {
	for d in /sys/class/backlight/*; do
		[ -r "$d/type" ] || continue
		read -r t <"$d/type" 2>/dev/null
		[ "$t" = raw ] && { printf '%s\n' "$d"; return 0; }
	done
	for d in /sys/class/backlight/*; do
		[ -d "$d" ] && { printf '%s\n' "$d"; return 0; }
	done
	return 1
}

pct() { [ "$2" -gt 0 ] 2>/dev/null && echo $(( $1 * 100 / $2 )) || echo 0; }

# --- cpu ---------------------------------------------------------------------
# A percentage needs two samples. 150ms is short enough to feel instant on a
# keypress and long enough that the number is not dominated by rounding.
cpu_sample() {
	awk '/^cpu /{idle=$5+$6; tot=0; for(i=2;i<=NF;i++) tot+=$i; print tot, idle; exit}' /proc/stat
}
cpu=""
if [ -r /proc/stat ]; then
	s1=$(cpu_sample); sleep 0.15; s2=$(cpu_sample)
	cpu=$(awk -v a="$s1" -v b="$s2" 'BEGIN{
		split(a,x," "); split(b,y," ");
		dt=y[1]-x[1]; di=y[2]-x[2];
		printf "%d", (dt>0) ? (100*(dt-di)/dt) + 0.5 : 0 }')
fi

# --- memory ------------------------------------------------------------------
mem=""; swap=""
if [ -r /proc/meminfo ]; then
	eval "$(awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} /^SwapTotal:/{st=$2} /^SwapFree:/{sf=$2}
		END{ printf "mem=%d\n", (t>0)? (100*(t-a)/t)+0.5 : 0
		     printf "swap=%d\n", (st>0)? (100*(st-sf)/st)+0.5 : 0 }' /proc/meminfo)"
fi

# --- disk / temps / fan ------------------------------------------------------
set -- $(df -P / 2>/dev/null | awk 'NR==2{gsub("%","",$5); print $5, $4}')
disk_pct=${1:-}; disk_free_k=${2:-}
disk_free=$(awk -v k="${disk_free_k:-0}" 'BEGIN{ printf "%.0fG", k/1048576 }')

cputemp=$(hwmon coretemp temp1_input 2>/dev/null); [ -n "$cputemp" ] && cputemp=$((cputemp / 1000))
nvmetemp=$(hwmon nvme temp1_input 2>/dev/null);    [ -n "$nvmetemp" ] && nvmetemp=$((nvmetemp / 1000))
fan=$(waybar-fan 2>/dev/null | tr -d '󰈐 ')

# --- power / backlight / audio -----------------------------------------------
bat=""; batstate=""
for b in /sys/class/power_supply/BAT*; do
	[ -r "$b/capacity" ] || continue
	read -r bat <"$b/capacity" 2>/dev/null
	read -r batstate <"$b/status" 2>/dev/null
	break
done

bl=""
d=$(backlight_dev) && {
	read -r cur <"$d/brightness" 2>/dev/null
	read -r max <"$d/max_brightness" 2>/dev/null
	bl=$(pct "${cur:-0}" "${max:-0}")
}

vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{
	v=int($2*100+0.5); print (/MUTED/) ? "muted (" v "%)" : v "%" }')
mic=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q MUTED && echo "muted" || echo "live")

# --- network -----------------------------------------------------------------
iface=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
if [ -n "${iface:-}" ]; then
	ip4=$(ip -4 addr show dev "$iface" 2>/dev/null | awk '/inet /{print $2; exit}')
	ssid=$(nmcli -t -f active,ssid,signal dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2" "$3"%"; exit}')
	net="${ssid:-$iface}  ${ip4:-}"
else
	net="offline"
fi

# --- media / weather ---------------------------------------------------------
media=$(playerctl metadata --format '{{artist}} — {{title}}' 2>/dev/null)
[ "$(playerctl status 2>/dev/null)" = "Paused" ] && media="$media (paused)"

# wttrbar is a network call, so it is cached for 15 minutes rather than made to
# sit in front of a keypress. No --location: it geolocates, which is the point of
# a laptop.
WX="$RUN/status-weather"
if [ ! -s "$WX" ] || [ "$(( $(date +%s) - $(stat -c %Y "$WX" 2>/dev/null || echo 0) ))" -gt 900 ]; then
	wttrbar --fahrenheit --mph --ampm --nerd --hide-conditions \
		--custom-indicator '{ICON} {temp_F}°  {FeelsLikeF}° felt' >"$WX" 2>/dev/null &
fi
wx=$(jq -r '.text // empty' <"$WX" 2>/dev/null)

# --- mango: tags and focused window ------------------------------------------
# Only under mango; mmsg needs MANGO_INSTANCE_SIGNATURE and there is nothing
# useful to say about tags from any other session.
tags=""; win=""
if command -v mmsg >/dev/null 2>&1 && [ -n "${MANGO_INSTANCE_SIGNATURE:-}" ]; then
	tags=$(mmsg get all-tags 2>/dev/null | jq -r '
		[ .all_tags[0].tags[]
		  | select(.is_active or (.client_count // 0) > 0)
		  | if .is_urgent then "!\(.index)" elif .is_active then "[\(.index)]" else "\(.index)" end
		] | join(" ")' 2>/dev/null)
	win=$(mmsg get focusing-client 2>/dev/null | jq -r '
		if .title == null or .title == "" then empty else "\(.appid // "?") — \(.title)" end' 2>/dev/null)
fi

# --- draw --------------------------------------------------------------------
# One notification, replacing the last, so repeated presses do not stack. The id
# has to be one the SERVER handed out -- a made-up constant is "unknown" to a
# spec-strict daemon and yields a new popup every time -- so it is captured with
# -p and remembered, exactly as `osd` does.
ID_FILE="$RUN/status-notification-id"

line() { [ -n "${2:-}" ] && printf '%-7s%s\n' "$1" "$2"; }

body=$(
	line "tags"  "${tags:-}"
	line "win"   "${win:-}"
	line "cpu"   "$(printf '%s%%' "${cpu:-?}")$([ -n "$cputemp" ] && printf '  %s°C' "$cputemp")"
	line "mem"   "$(printf '%s%%  swap %s%%' "${mem:-?}" "${swap:-?}")"
	line "disk"  "$(printf '%s%% used, %s free' "${disk_pct:-?}" "${disk_free:-?}")"
	line "nvme"  "$([ -n "$nvmetemp" ] && printf '%s°C' "$nvmetemp")$([ -n "$fan" ] && printf '  fan %s' "$fan")"
	line "power" "$(printf '%s%% %s' "${bat:-?}" "$(echo "${batstate:-}" | tr 'A-Z' 'a-z')")$([ -n "$bl" ] && printf '  screen %s%%' "$bl")"
	line "audio" "$(printf 'out %s  mic %s' "${vol:-?}" "${mic:-?}")"
	line "net"   "${net:-}"
	line "media" "${media:-}"
	line "wx"    "${wx:-}"
	line "up"    "$(waybar-uptime 2>/dev/null | tr -d '󰅐 ')"
)

prev=$(cat "$ID_FILE" 2>/dev/null); [ -n "$prev" ] || prev=0
id=$(notify-send -p -a status -r "$prev" -t 8000 "$(date '+%a %d %b   %H:%M')" "$body")
[ -n "$id" ] && printf '%s\n' "$id" >"$ID_FILE"

# The id file is best-effort: a daemon that returns nothing must not make the
# keybind look like it failed.
exit 0
