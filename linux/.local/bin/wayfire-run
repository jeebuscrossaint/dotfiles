#!/bin/sh
# wayfire-run — start a wayfire session from a TTY.
#
# Same three jobs as mango-run and labwc-run, for the same reasons; read either of
# those for the long version.

# fd limit before the compositor starts. Past the 1024 soft limit a wlroots
# compositor stays responsive but can no longer ACCEPT new clients -- the session
# looks fine while nothing new will launch.
hard=$(ulimit -Hn 2>/dev/null) || hard=""
case "$hard" in
unlimited) hard=65536 ;;
'' | *[!0-9]*) hard="" ;;
esac
[ -n "$hard" ] && ulimit -n "$hard" 2>/dev/null

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wayfire"
LOG="$LOG_DIR/wayfire.log"
if mkdir -p "$LOG_DIR" 2>/dev/null; then
	[ -f "$LOG" ] && mv -f "$LOG" "$LOG.1" 2>/dev/null
	exec 2>>"$LOG"
	printf '=== session started %s on %s ===\n' "$(date '+%F %T')" "$(uname -s)" >&2
fi

# Validate first. wayfire has no dry-run flag either, and it is WORSE than labwc
# here: it ignores unknown sections and unknown keys silently, so a typo is a
# setting that does nothing rather than an error. wayfire-check compares every key
# against the metadata wayfire itself ships.
if command -v wayfire-check >/dev/null 2>&1; then
	if ! wayfire-check >/dev/null 2>&1; then
		echo "wayfire-run: config problems below. Starting anyway -- unknown keys are" >&2
		echo "wayfire-run: ignored by wayfire, they will not stop the session." >&2
		wayfire-check >&2 2>&1
	fi
fi

# XDG_CURRENT_DESKTOP is load-bearing for portals: it selects which portals.conf
# xdg-desktop-portal reads. wayfire ships wayfire-portals.conf in some distros; if
# screen sharing misbehaves, that is the first thing to check.
XDG_CURRENT_DESKTOP=wayfire
XDG_SESSION_TYPE=wayland
XDG_SESSION_DESKTOP=wayfire
export XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP

# One D-Bus session bus around the whole session. Artix has no systemd to create
# $XDG_RUNTIME_DIR/bus, so without this every client autolaunches its own and fnott
# ends up on a different bus from notify-send -- notifications then "randomly" stop
# with nothing in any log.
if command -v dbus-run-session >/dev/null 2>&1; then
	exec dbus-run-session -- wayfire "$@"
fi

echo "wayfire-run: dbus-run-session not found; starting without a session bus." >&2
echo "wayfire-run: expect notifications and portals to misbehave." >&2
exec wayfire "$@"
