#!/bin/sh
# labwc-run — start a labwc session from a TTY.
#
# The counterpart to mango-run, and thin for the same reason: rc.xml owns the
# keybinds, `environment` owns the environment and `autostart` owns the daemons.
# What is left is the handful of things that must happen BEFORE the compositor
# exists.

# Raise the fd limit before the compositor starts. sway does this for itself
# (increase_nofile_limit()); labwc, like mango, does not, so it inherits the 1024
# soft limit. Past that a wlroots compositor stays responsive but can no longer
# ACCEPT new client connections -- the session looks healthy while nothing new
# will launch.
hard=$(ulimit -Hn 2>/dev/null) || hard=""
case "$hard" in
unlimited) hard=65536 ;;
'' | *[!0-9]*) hard="" ;;
esac
[ -n "$hard" ] && ulimit -n "$hard" 2>/dev/null

# Keep stderr. From a TTY it scrolls away, which is why an overnight dwl failure
# left nothing to diagnose and cost most of a day guessing.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/labwc"
LOG="$LOG_DIR/labwc.log"
if mkdir -p "$LOG_DIR" 2>/dev/null; then
	[ -f "$LOG" ] && mv -f "$LOG" "$LOG.1" 2>/dev/null
	exec 2>>"$LOG"
	printf '=== session started %s on %s ===\n' "$(date '+%F %T')" "$(uname -s)" >&2
fi

# Validate what can be validated. labwc has no dry-run flag, so this is only an
# XML well-formedness check plus a PATH check on the Execute targets -- it cannot
# catch a misspelled action name. Malformed XML is worth refusing to start over:
# labwc would come up with a default keymap and no way back but the TTY.
if command -v labwc-check >/dev/null 2>&1; then
	if ! labwc-check >/dev/null 2>&1; then
		echo "labwc-run: config problems, not starting. Full output:" >&2
		labwc-check >&2 2>&1
		echo "labwc-run: fix ~/.config/labwc/rc.xml and try again." >&2
		exit 1
	fi
fi

# Start the session under ONE D-Bus session bus, for exactly the reason mango-run
# does: Artix has no systemd to create $XDG_RUNTIME_DIR/bus, so without this every
# client that needs D-Bus autolaunches its OWN bus. That leaves fnott sitting on one
# bus and notify-send talking to another, and notifications "randomly" stop working
# with no error anywhere -- the daemon running, the name simply unowned on whichever
# bus the sender reached.
#
# This is ALSO why the old ~/.config/labwc/autostart was wrong to run
# `eval $(dbus-launch --sh-syntax --exit-with-session)`: autostart runs from inside
# the compositor, far too late to give the compositor's own children an address, and
# it created a second bus rather than joining one.
#
# dbus-run-session creates one bus, exports DBUS_SESSION_BUS_ADDRESS into it, and
# runs labwc inside -- so labwc, everything in autostart, and every app launched
# from a keybind all inherit the same address. It is also what makes the
# `dbus-update-activation-environment` line in autostart meaningful.
if command -v dbus-run-session >/dev/null 2>&1; then
	exec dbus-run-session -- labwc "$@"
fi

echo "labwc-run: dbus-run-session not found; starting without a session bus." >&2
echo "labwc-run: expect notifications and portals to misbehave." >&2
exec labwc "$@"
