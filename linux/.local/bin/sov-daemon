#!/bin/sh
# sov (workspace overview) daemon.
#
# sov has no IPC and no toggle flag: it reads "1" (show) / "0" (hide) lines on
# stdin. So the daemon is really a fifo with a `tail -f` pump feeding sov, and
# the sway binds just echo into that fifo.
#
# Idempotent on purpose — sway re-runs exec_always on every reload, and coat
# triggers a reload on every theme switch, so this gets called a lot.

FIFO="${XDG_RUNTIME_DIR:-/tmp}/sov.fifo"

pkill -x sov 2>/dev/null
pkill -f "tail -f $FIFO" 2>/dev/null
rm -f "$FIFO"

mkfifo "$FIFO" || exit 1

# -t: ms to wait before drawing, so a quick tap doesn't flash the overlay
# -c: thumbnail columns   -r: screen-to-thumbnail ratio (bigger = smaller grid)
exec sh -c "tail -f '$FIFO' | sov -t 120 -c 5 -r 8"
