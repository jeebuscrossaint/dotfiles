#!/bin/sh
# audio-ensure — bring the audio stack up, but ONLY when it is actually broken.
#
# The test is the hard part. `wpctl status | grep "Sinks:"` prints that header
# whether or not a real sink is behind it, so it passed on a completely dead
# stack. What identifies a dead stack is the null sink pipewire invents when it
# can reach no hardware -- factory.name support.null-audio-sink / node.name
# auto_null. Those are pipewire's internal names, so this tests the condition
# rather than a rendered label like "Dummy Output", which can be renamed.
#
# The repair is always `restart`, never bare: artix-pipewire-launcher bails at
# "already running" the moment it sees ANY pipewire process, so it never reaches
# its wireplumber line -- and a stale pipewire holding dead sockets is exactly
# the case this script exists for.
#
#   audio-ensure           repair if broken, stay silent if not
#   audio-ensure --check   report only (exit 0 healthy, 1 broken)
#
# Always exits 0 in repair mode: a session must not fail to start over audio.

CHECK_ONLY=0
[ "$1" = "--check" ] && CHECK_ONLY=1

# Not a pipewire machine (OpenBSD uses sndio); nothing to do either way.
if ! command -v wpctl >/dev/null 2>&1; then
	[ "$CHECK_ONLY" = 1 ] && echo "audio-ensure: no wpctl, not a pipewire system"
	exit 0
fi

broken_reason() {
	# No daemon at all.
	if ! pgrep -x pipewire >/dev/null 2>&1; then
		echo "pipewire is not running"
		return 0
	fi
	# No session manager: without it nothing ever links a device to a sink.
	if ! pgrep -x wireplumber >/dev/null 2>&1; then
		echo "wireplumber is not running"
		return 0
	fi
	# Daemon up but talking to nothing. `wpctl inspect` fails outright when the
	# socket is stale, which counts as broken too.
	sink=$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null) || {
		echo "cannot inspect the default sink"
		return 0
	}
	case "$sink" in
	*support.null-audio-sink* | *auto_null*)
		echo "the default sink is pipewire's null fallback (no real device)"
		return 0
		;;
	esac
	return 1
}

reason=$(broken_reason)

if [ -z "$reason" ]; then
	[ "$CHECK_ONLY" = 1 ] && echo "audio-ensure: healthy"
	exit 0
fi

if [ "$CHECK_ONLY" = 1 ]; then
	echo "audio-ensure: BROKEN -- $reason"
	exit 1
fi

command -v artix-pipewire-launcher >/dev/null 2>&1 || exit 0
artix-pipewire-launcher restart >/dev/null 2>&1

# wireplumber needs a moment to enumerate devices, so a check straight after the
# restart would still see auto_null and report failure on a repair that worked.
i=0
while [ "$i" -lt 10 ]; do
	sleep 1
	if [ -z "$(broken_reason)" ]; then
		# Silent on success: the repair legitimately runs on every login, so a
		# notification each time is noise. Only a FAILED repair is worth it.
		exit 0
	fi
	i=$((i + 1))
done

command -v notify-send >/dev/null 2>&1 &&
	notify-send -u critical "󰝟  Audio" "restart did not recover: $(broken_reason)"
exit 0
