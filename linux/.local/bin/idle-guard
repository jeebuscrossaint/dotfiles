#!/bin/sh
# idle-guard — lock only when nothing is actually happening.
#
#   idle-guard lock    lock, but wait out any audio that is still playing
#   idle-guard blank   power the outputs off, waiting out audio the same way
#   idle-guard wake    power them back on
#   idle-guard now     lock immediately -- Super+L, and before-sleep
#   idle-guard cancel  abort every pending guard (the user came back)
#
# Everything that locks goes through here, which is the only reason swaylock can
# be given the wallpaper on the command line instead of having it written into
# its config. See do_lock.
#
# The problem this solves: swayidle fires on INPUT idleness alone, so watching a
# video with the keyboard untouched locks the screen at the timeout. There is no
# toggle to remember here -- it works out for itself whether something is playing.
#
# swayidle fires each timeout ONCE per idle period, so the guard cannot simply
# decline and expect to be asked again. It waits instead, re-checking until the
# audio stops, and the on-resume hook kills it if input returns first.

RUN="${XDG_RUNTIME_DIR:-/tmp}"

audio_playing() {
	# ALSA's own view, which covers anything routed through pipewire without
	# needing to ask pipewire. A stream that is open but paused reads as
	# something other than RUNNING.
	grep -qx RUNNING /proc/asound/card*/pcm*/sub*/status 2>/dev/null && return 0
	# Fallback for players that report through MPRIS but are not holding a PCM
	# open at this instant.
	[ "$(playerctl status 2>/dev/null)" = "Playing" ] && return 0
	return 1
}

# The wallpaper is resolved at LOCK time, not stored. swaylock's config used to
# carry an image= line that the awww wrapper rewrote on every `awww img` -- a
# config file edited by a program, living on a stow symlink, so every wallpaper
# change showed up as a one-line diff in the repo. swaylock has no variables and
# no command substitution (its parser takes `key=value` and little else), but it
# does take -i, and the daemon knows the answer already. Asking at the moment of
# use means there is no copy to keep in sync and nothing to rewrite.
#
# `query` rather than a remembered path: img takes --outputs and --transition-*,
# so the wallpaper is not reliably the last word of any command line. The
# daemon's own answer is, and its last colon-space field is the path.
#
# No awww, no wallpaper, or a path that has since been deleted: lock with no -i
# and swaylock paints its color= instead. That is also what the OpenBSD box does,
# where there is no awww at all.
do_lock() {
	sfx lock
	wall=$(awww query 2>/dev/null | grep -v HEADLESS | head -1)
	wall=${wall##*: }
	if [ -n "$wall" ] && [ -f "$wall" ]; then
		swaylock -i "$wall" >/dev/null 2>&1 &
	else
		swaylock >/dev/null 2>&1 &
	fi
}

# wlopm, not `wlr-randr --output X --off`: this is a power mode change on an
# output that stays where it is. Disabling the output instead makes wlroots tear
# it down and rehome every window on it, which on a one-screen machine is nowhere.
#
# wlopm 1.0.0 takes one output name per flag and understands no wildcard, so the
# listing it prints with no arguments is the list to act on.
set_power() {
	wlopm | while read -r out _; do
		wlopm "--$1" "$out"
	done
}

# One file per invocation, not one per action. A held-down resume can overlap two
# guards, and a shared pid file meant `cancel` killed the newest and left the
# other one waiting to lock the screen under you.
case "$1" in
cancel)
	for f in "$RUN"/idle-guard.*.pid; do
		[ -f "$f" ] || continue
		kill "$(cat "$f")" 2>/dev/null
		rm -f "$f"
	done
	exit 0
	;;
now)
	# No guard and no state file: the user asked for it, or the machine is going
	# to sleep and there is nothing left to wait for.
	do_lock
	exit 0
	;;
wake)
	# Never guarded. Coming back has to be immediate, and there is nothing to
	# wait out -- audio playing is a reason to stay awake, not to stay dark.
	set_power on
	exit 0
	;;
lock | blank) action="$1" ;;
*) exit 0 ;;
esac

STATE="$RUN/idle-guard.$action.$$.pid"
echo $$ > "$STATE"
trap 'rm -f "$STATE"' EXIT

while audio_playing; do
	sleep 30
done

case "$action" in
lock) do_lock ;;
blank) set_power off ;;
esac
