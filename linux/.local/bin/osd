#!/bin/sh
# osd — perform a volume/brightness/lock-key change and draw the on-screen
# display as a notification that REPLACES the previous one.
#
# No OSD daemon by design. swayosd and wob were each retired for the same
# reason: both read their styling once at startup, so a coat theme change meant
# killing the process, which raced its supervisor and left the media keys
# silently dead until the next login. The notification daemon draws everything
# now and there is nothing to kill.
#
# Usage:
#   osd volume up|down|mute
#   osd mic mute
#   osd brightness up|down          screen backlight
#   osd kbd up|down|show            keyboard backlight
#   osd capslock|numlock
#   osd touchpad                    toggle, through the compositor
#   osd playpause|next|prev
#
# Nothing stacks: see OSD_ID below.

SINK=@DEFAULT_AUDIO_SINK@
SOURCE=@DEFAULT_AUDIO_SOURCE@

# The panel's backlight device is NOT stable across boots. Which card drives eDP
# is set by the BIOS MUX (asus-nb-wmi/gpu_mux_mode: 1=Hybrid, 0=Discrete), and
# only the driver that owns the panel registers a backlight -- so it is
# intel_backlight in Hybrid and nvidia_0 in Discrete, with the other name absent
# entirely rather than present-but-dead. Hardcoding intel_backlight left the
# brightness keys silently doing nothing for a whole MUX mode. Resolved at
# runtime below, the same way hyprland.lua resolves the scanout card.

VOL_STEP=5
VOL_MAX=1.5 # wpctl ceiling (150%)
BL_STEP=5   # percent of max_brightness per keypress
BL_MIN=1    # never step the backlight to 0 — that is a black screen

# The ASUS keyboard backlight. A 4-step LED (0..3), not a percentage device, so
# it steps by 1 rather than by BL_STEP.
KBD_LED=asus::kbd_backlight

# Night light: 4000K is warm enough to matter after dark without going orange.
# Desktop event sounds go through ~/.local/bin/sfx, which is a no-op if the theme
# is missing or ~/.config/sfx-mute exists. Volume gets one because you are already
# thinking about audio; brightness deliberately does not, since a click on every
# step of a held key is maddening.
NIGHT_TEMP=4000
NIGHT_FLAG="${XDG_RUNTIME_DIR:-/tmp}/osd-nightlight"

# Whether the touchpad is currently off. Neither compositor can be asked (see
# the touchpad section), so the state is tracked here.
TP_FLAG=${XDG_RUNTIME_DIR:-/tmp}/touchpad-off

# Let a lock-key LED catch up with the keypress: the flip is already in flight
# when this runs but lands in the kernel a few ms later, so reading immediately
# reports the OLD value. Imperceptible next to the notification's own latency.
LOCK_SETTLE=0.15

usage() {
	echo "usage: osd {volume up|down|mute | mic mute | brightness up|down |" >&2
	echo "           kbd up|down|show | capslock | numlock | touchpad |" >&2
	echo "           playpause | next | prev}" >&2
	exit 2
}

# Every popup REPLACES the last instead of stacking, via replaces_id.
#
# This used to be a fixed id (4242) on the reading that any nonzero value works.
# It does not: the spec says replaces_id must be an id the SERVER handed out, and
# a daemon that takes that literally treats 4242 as unknown and creates a new
# popup every time. fnott was lenient about it; the Quickshell shell that
# replaced fnott is not, and a held volume key stacked one banner per repeat.
#
# So the id is captured from the server with -p and remembered for the next call.
# Spec-correct, and it works under fnott, mako and dunst as well. A stale id --
# after the popup has expired, or across a daemon restart -- is simply unknown
# again and yields a fresh popup, which is the right outcome.
OSD_ID_FILE="${XDG_RUNTIME_DIR:-/tmp}/osd-notification-id"

# show <text> [value 0-100]
#
# A value turns the popup into a level meter: int:value is the hint the daemon
# draws its progress bar from. Omit it for on/off.
#
# notify-send, not dunstify: dunstify ships with dunst, which is neither the
# daemon here nor in OpenBSD's wayland ports.
show() {
	prev=$(cat "$OSD_ID_FILE" 2>/dev/null)
	[ -n "$prev" ] || prev=0

	if [ -n "${2:-}" ]; then
		id=$(notify-send -p -a osd -r "$prev" -h "int:value:$2" "$1")
	else
		id=$(notify-send -p -a osd -r "$prev" "$1")
	fi

	[ -n "$id" ] && printf '%s\n' "$id" > "$OSD_ID_FILE"
}

# backlight_device -> the sysfs name of the panel's backlight, or empty.
#
# Order matters when more than one exists. A native "raw" device is the real
# panel control; acpi_video0 is a "firmware" ACPI shim that is frequently
# present and frequently does nothing, so it goes last. OSD_BACKLIGHT overrides
# for testing without a reboot into the other MUX mode.
backlight_device() {
	if [ -n "${OSD_BACKLIGHT:-}" ]; then
		echo "$OSD_BACKLIGHT"
		return
	fi
	for _d in intel_backlight amdgpu_bl2 amdgpu_bl1 amdgpu_bl0 \
		nvidia_wmi_ec_backlight nvidia_0 acpi_video0; do
		if [ -r "/sys/class/backlight/$_d/brightness" ]; then
			echo "$_d"
			return
		fi
	done
	# Unknown name: any raw device beats any firmware one.
	for _want in raw firmware platform; do
		for _p in /sys/class/backlight/*/; do
			[ -r "$_p/brightness" ] || continue
			read -r _type <"$_p/type" 2>/dev/null || continue
			[ "$_type" = "$_want" ] || continue
			basename "$_p"
			return
		done
	done
}

# vol_state <target> -> VOL (integer percent), MUTED (0|1)
# `wpctl get-volume` prints "Volume: 0.42", or "Volume: 0.42 [MUTED]" when muted.
vol_state() {
	_out=$(wpctl get-volume "$1" 2>/dev/null) || return 1
	case $_out in
	*MUTED*) MUTED=1 ;;
	*) MUTED=0 ;;
	esac
	_raw=${_out#*: }
	_raw=${_raw%% *}
	# awk, not shell arithmetic: wpctl reports a float and sh has no floats.
	VOL=$(awk -v v="$_raw" 'BEGIN { printf "%d", v * 100 + 0.5 }')
}

case "$1" in

# -------------------------------------------------------------------- volume
volume)
	case "$2" in
	up) wpctl set-volume -l "$VOL_MAX" "$SINK" "${VOL_STEP}%+" ;;
	down) wpctl set-volume "$SINK" "${VOL_STEP}%-" ;;
	mute) wpctl set-mute "$SINK" toggle ;;
	*) usage ;;
	esac

	# Read the level back rather than tracking it: wpctl clamps at both ends and
	# the sink can also be changed from elsewhere (swayrbar shows the same value).
	vol_state "$SINK" || exit 1

	if [ "$MUTED" = 1 ] || [ "$VOL" -eq 0 ]; then
		icon='󰝟'
	elif [ "$VOL" -ge 66 ]; then
		icon='󰕾'
	elif [ "$VOL" -ge 33 ]; then
		icon='󰖀'
	else
		icon='󰕿'
	fi

	# Muted still gets a bar, emptied: the popup then reads as "silenced" at a
	# glance instead of just losing a widget.
	if [ "$MUTED" = 1 ]; then
		# The real volume, not 0: the meter then shows what you have silenced
		# rather than snapping to empty and losing the information.
		show "$icon  muted" "$VOL"
	else
		sfx volume
	show "$icon  $VOL%" "$VOL"
	fi
	;;

# ----------------------------------------------------------------------- mic
mic)
	case "$2" in
	mute) wpctl set-mute "$SOURCE" toggle ;;
	*) usage ;;
	esac
	vol_state "$SOURCE" || exit 1
	if [ "$MUTED" = 1 ]; then
		show '󰍭  mic muted'
	else
		show '󰍬  mic on'
	fi
	;;

# ---------------------------------------------------------------- brightness
brightness)
	BACKLIGHT=$(backlight_device)
	if [ -z "$BACKLIGHT" ]; then
		# Nothing registered a backlight, or the brightnessctl udev rule never ran
		# (it chgrps the sysfs node to `video`). Say so rather than exiting mute --
		# a dead brightness key with no feedback is what made this hard to spot.
		show "󰃞  No backlight device"
		exit 1
	fi

	# Read through sysfs, write through brightnessctl: reading is two builtin
	# reads with no fork, but writing needs brightnessctl's udev/seat privileges.
	read -r cur <"/sys/class/backlight/$BACKLIGHT/brightness" || exit 1
	read -r max <"/sys/class/backlight/$BACKLIGHT/max_brightness" || exit 1
	[ "$max" -gt 0 ] || exit 1

	# Stepping in raw units, not `brightnessctl set 5%-`: percentage steps round
	# against each other, so up-then-down does not return to where it started.
	step=$((max * BL_STEP / 100))
	[ "$step" -lt 1 ] && step=1
	floor=$((max * BL_MIN / 100))
	[ "$floor" -lt 1 ] && floor=1

	case "$2" in
	up)
		new=$((cur + step))
		[ "$new" -gt "$max" ] && new=$max
		;;
	down)
		new=$((cur - step))
		[ "$new" -lt "$floor" ] && new=$floor
		;;
	*) usage ;;
	esac

	brightnessctl -q -d "$BACKLIGHT" set "$new" || exit 1
	pct=$((new * 100 / max))
	if [ "$pct" -ge 50 ]; then icon='󰃠'; else icon='󰃞'; fi
	show "$icon  $pct%" "$pct"
	;;

# -------------------------------------------------------- keyboard backlight
kbd)
	# Four discrete steps, so the popup says "2/3" rather than a rounded
	# percentage. The bar still gets a percentage; int:value draws nothing else.
	led=/sys/class/leds/$KBD_LED
	[ -r "$led/brightness" ] || exit 0
	read -r cur <"$led/brightness" || exit 1
	read -r max <"$led/max_brightness" || exit 1
	[ "$max" -gt 0 ] || exit 1

	case "$2" in
	up)
		new=$((cur + 1))
		[ "$new" -gt "$max" ] && new=$max
		;;
	down)
		new=$((cur - 1))
		[ "$new" -lt 0 ] && new=0
		;;
	# Report without touching. Use this if the firmware steps the LED itself.
	show) new=$cur ;;
	*) usage ;;
	esac

	# -c leds is required: brightnessctl defaults to the backlight class and
	# would not find this device at all without it.
	note=""
	if [ "$new" != "$cur" ]; then
		if brightnessctl -q -c leds -d "$KBD_LED" set "$new" 2>/dev/null; then
			:
		else
			# A group-membership problem, not a missing rule: brightnessctl's udev
			# rule chgrps LED brightness to `input`. Silent otherwise -- the popup
			# would show an unchanged level and look like the key did nothing.
			# misc/99-kbd-backlight.rules is the narrower fix.
			new=$cur
			note=" — read-only"
		fi
	fi

	pct=$((new * 100 / max))
	if [ "$new" -eq 0 ]; then icon='󰌍'; else icon='󰌌'; fi
	show "$icon  kbd $new/$max$note" "$pct"
	;;

# ----------------------------------------------------------------- nightlight
nightlight | night)
	# Blue-light shift. hyprsunset owns the gamma; this owns the STATE, because
	# hyprsunset has no query -- you can ask whether the process exists and
	# nothing more -- so "is it on" is a flag file, exactly like touchpad below.
	#
	# Kill and respawn rather than talk to it: hyprsunset's IPC has moved between
	# versions, but a process either exists or it does not.
	if pgrep -x hyprsunset >/dev/null 2>&1; then
		pkill -x hyprsunset
		rm -f "$NIGHT_FLAG"
		show "󰖨  Night light off"
	elif command -v hyprsunset >/dev/null 2>&1; then
		setsid hyprsunset -t "$NIGHT_TEMP" >/dev/null 2>&1 &
		touch "$NIGHT_FLAG"
		show "󰖔  Night light ${NIGHT_TEMP}K"
	else
		show "󰖨  hyprsunset not installed"
	fi
	;;

# -------------------------------------------------------------------- touchpad
touchpad)
	# NEITHER compositor reports the result -- mango's all-devices has no enabled
	# flag and Hyprland has no query for it -- hence the flag file. Which is why
	# both trackpad binds route through here: a native bind would flip the device
	# behind the flag's back and every popup after would lie.
	if [ -f "$TP_FLAG" ]; then want=on; else want=off; fi

	if [ -n "${MANGO_INSTANCE_SIGNATURE:-}" ]; then
		# mango's own toggle -- one dispatch, no device name to resolve.
		mmsg dispatch toggle_trackpad_enable >/dev/null 2>&1 || exit 1
	elif [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
		# Hyprland takes the device name as libinput reports it. It has to go
		# through `eval` in Lua form: the non-legacy parser rejects `hyprctl
		# keyword` outright ("keyword can't work with non-legacy parsers") and
		# STILL exits 0, so the keyword version flipped the flag, drew the
		# popup and never touched the device. Same trap as auto-refresh.
		command -v jq >/dev/null || exit 0
		tp=$(hyprctl devices -j 2>/dev/null |
			jq -r '.mice[]? | select(.name | test("touchpad"; "i")) | .name' | head -1)
		[ -n "$tp" ] || exit 0
		case $want in
		on) en=true ;;
		off) en=false ;;
		esac
		# eval reports failure in its OUTPUT, not its exit status -- it prints
		# "ok" on success and the Lua error otherwise, exiting 0 either way.
		[ "$(hyprctl eval "hl.device({ name = \"$tp\", enabled = $en })" 2>&1)" = ok ] || exit 1
	else
		# No compositor to ask (a TTY, or a session that does not do this).
		exit 0
	fi

	if [ "$want" = on ]; then
		rm -f "$TP_FLAG"
		show '󰟸  touchpad on'
	else
		: >"$TP_FLAG"
		show '󰤳  touchpad off'
	fi
	;;

# ------------------------------------------------------------------ lock keys
# Display only -- the key toggles itself, this reports it. The kernel LED is the
# source of truth; three keyboards expose these here, and any one lit means on.
#
# Binding these on PRESS is safe: the compositor declining to forward a key only
# skips wlr_seat_keyboard_notify_key, and xkb has already processed the keycode
# and pushed the LED upstream of that (mango 0.16.1 keypress(), src/input/
# keyboard.h). Caps lock keeps capitalising. LOCK_SETTLE covers the read.
capslock | numlock)
	sleep "$LOCK_SETTLE"
	on=0
	for f in /sys/class/leds/*::"$1"/brightness; do
		[ -r "$f" ] || continue
		read -r v <"$f"
		[ "$v" -gt 0 ] && {
			on=1
			break
		}
	done

	case "$1" in
	capslock) icon='󰘲' label='caps lock' ;;
	numlock) icon='󰎠' label='num lock' ;;
	esac

	if [ "$on" = 1 ]; then
		show "$icon  $label on"
	else
		show "$icon  $label off"
	fi
	;;

# --------------------------------------------------------------------- media
playpause | next | prev)
	case "$1" in
	playpause) playerctl play-pause 2>/dev/null || exit 0 ;;
	# `previous`, not `prev`: that is playerctl's spelling. The subcommand here
	# stays `prev` to match XF86AudioPrev.
	next) playerctl next 2>/dev/null || exit 0 ;;
	prev) playerctl previous 2>/dev/null || exit 0 ;;
	esac
	# playerctl keeps reporting the pre-toggle status for a moment after the
	# call, so give the player a beat to settle before asking what it did. The
	# key press has already taken effect — this only delays the popup.
	sleep 0.2
	status=$(playerctl status 2>/dev/null) || exit 0
	text=$(playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null)
	text=${text# - }
	[ "${#text}" -gt 48 ] && text=$(printf '%.47s…' "$text")
	# A skip shows which way it went; play/pause shows the resulting state. Both
	# then print the track, which is the useful part of either popup.
	case "$1" in
	next) icon='󰒭' ;;
	prev) icon='󰒮' ;;
	*)
		case $status in
		Playing) icon='󰐊' ;;
		Paused) icon='󰏤' ;;
		*) exit 0 ;;
		esac
		;;
	esac
	show "$icon  ${text:-$status}"
	;;

*) usage ;;
esac
