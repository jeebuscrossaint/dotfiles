#!/bin/sh
# menu — a dmenu-style picker reading choices on stdin, for scripts.
#
# The NAME is the point: every caller says `menu`, so the picker underneath swaps
# with no edits anywhere else. It was wmenu, then `fuzzel --dmenu`, and since
# 2026-09-02 it is the Quickshell shell's Picker component.
#
# Flags kept for source compatibility with the callers that already exist:
#     -p PROMPT   placeholder text in the field
#     -l LINES    accepted and ignored; the palette sizes itself
#     -i          accepted and ignored; matching is always case-insensitive
#
# How the answer gets back: an IPC call cannot block waiting for a human, so the
# choices go to a temp file, a FIFO is created for the reply, the shell is told
# about both, and this script then sits in `cat` on the FIFO until the Picker
# writes to it. A cancelled pick writes an empty line, so `cat` always returns
# and the caller's `[ -n "$pick" ] || exit 0` still works.
set -u

prompt=""

while [ $# -gt 0 ]; do
	case "$1" in
	-p)
		prompt="${2:-}"
		shift 2
		;;
	-l)
		shift 2
		;;
	-i)
		shift
		;;
	*)
		shift
		;;
	esac
done

if ! pgrep -x qs >/dev/null 2>&1; then
	echo "menu: the Quickshell shell is not running" >&2
	exit 1
fi

dir=$(mktemp -d) || exit 1
trap 'rm -rf "$dir"' EXIT INT TERM

items="$dir/items"
reply="$dir/reply"

cat > "$items"
mkfifo "$reply" || exit 1

qs ipc call picker open "$items" "$reply" "$prompt" >/dev/null 2>&1

# Blocks until the Picker writes. An empty line means cancelled.
read -r pick < "$reply"
[ -n "$pick" ] || exit 0
printf '%s\n' "$pick"
