#!/bin/sh
# menu — a dmenu-style picker reading choices on stdin, for scripts.
#
# `fuzzel --dmenu`. The NAME is the point: every caller says `menu`, so the
# launcher underneath swaps with no edits anywhere else (it was wmenu until
# 2026-08-18). No colour flags to pass -- fuzzel reads its own config.
#
# wmenu's flags are TRANSLATED, since fuzzel spells them differently:
#     -p PROMPT  ->  --prompt="PROMPT ❯ "
#     -l LINES   ->  --lines=LINES
#     -i         ->  dropped; fuzzel is always case-insensitive, and an unknown
#                    flag would make it exit
#
# Arguments are rebuilt with `set --`, not accumulated in a string: unquoted
# word-splitting broke `--prompt=theme ❯` in two and lost the arrow.

prompt=""
lines=""

while [ $# -gt 0 ]; do
	case "$1" in
	-p)
		shift
		prompt="$1"
		;;
	-l)
		shift
		lines="$1"
		;;
	-i) ;;
	*)
		# Anything else is assumed to be a fuzzel flag already and is kept.
		set -- "$@" "$1"
		;;
	esac
	shift
done

set --
[ -n "$prompt" ] && set -- "$@" "--prompt=$prompt ❯ "
[ -n "$lines" ] && set -- "$@" "--lines=$lines"

exec fuzzel --dmenu "$@"
