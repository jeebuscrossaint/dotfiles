#!/usr/bin/env python3
"""mango-title — stream the FOCUSED window's title for waybar.

This replaces waybar's `wlr/taskbar`, which was the wrong module for the job:
taskbar renders a button per toplevel, so it listed every open window and its
`max-length` applies per button rather than to the row. With six windows open the
titles ran the full width of the panel and shoved the clock off the right edge.

`mmsg watch focusing-client` streams one JSON object per focus change:

    {"id":59,"title":"~","appid":"foot","monitor":"eDP-1","tags":[4],
     "is_fullscreen":false,...}

so this prints exactly one title, and updates the instant focus moves.
"""

import html
import json
import os
import shutil
import signal
import subprocess
import sys

MAX = 60

def coat_colors():
    """Read the palette out of coat's mango fragment.

    These are pango markup, not CSS, so coat cannot reach them the way it reaches
    a stylesheet -- waybar cannot style individual characters inside a custom
    module, which is why the colour is inline in the first place. Rather than add
    another coat module for two scripts, reuse the fragment coat already writes
    for the compositor: ~/.config/mango/coat-colors.conf, lines of the form
    `focuscolor=0xRRGGBBAA`.

    Falls back to Framer if the file is missing, so this still runs on a machine
    where coat has never been applied.
    """
    out = {
        "focused": "#20bcfc",
        "occupied": "#d0d0d0",
        "empty": "#747474",
        "urgent": "#fd886b",
    }
    # scratchpadcolor is base0D (the accent), focuscolor base05, bordercolor
    # base03, urgentcolor base08 -- see coat's templates/mango.tera.
    keymap = {
        "scratchpadcolor": "focused",
        "focuscolor": "occupied",
        "bordercolor": "empty",
        "urgentcolor": "urgent",
    }
    path = os.path.expanduser("~/.config/mango/coat-colors.conf")
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if "=" not in line or line.startswith("#"):
                    continue
                key, _, val = line.partition("=")
                slot = keymap.get(key.strip())
                if not slot:
                    continue
                val = val.strip()
                if val.startswith("0x") and len(val) >= 8:
                    # 0xRRGGBBAA -> #RRGGBB; pango wants no alpha channel.
                    out[slot] = "#" + val[2:8]
    except OSError:
        pass
    return out


ACCENT = coat_colors()["focused"]


def render(payload):
    title = (payload or {}).get("title") or ""
    appid = (payload or {}).get("appid") or ""

    if not title:
        return ""

    # Firefox and friends append " — Mozilla Firefox" to every title, which is
    # the least useful part of it and eats a third of the budget.
    for sep in (" — ", " - "):
        if sep in title and appid:
            head, _, tail = title.rpartition(sep)
            if appid.lower().split(".")[-1] in tail.lower().replace(" ", ""):
                title = head
                break

    if len(title) > MAX:
        title = title[: MAX - 1].rstrip() + "…"

    # escape(): a title containing & or < is markup to pango and would either
    # vanish or break the whole label.
    return f'<span color="{ACCENT}">{html.escape(title)}</span>'


def idle():
    """Render an empty module and block forever.

    Used when there is no mango to talk to. Blocking rather than returning is
    deliberate: waybar respawns a custom module whenever it EXITS, whatever the
    status, so returning costs a Python startup every restart-interval for the whole
    session and fills the log with "stopped unexpectedly, is it endless?".
    signal.pause() costs nothing.
    """
    print("", flush=True)
    signal.pause()
    return 0


def main():
    # Not under mango? Then there is nothing to stream.
    #
    # Checking the binary alone was NOT enough and this is the bug it hid: mmsg is
    # installed system-wide, so under a labwc session `which` found it, the script
    # ran, and mmsg exited 1 with "MANGO_INSTANCE_SIGNATURE is not set" -- which
    # ended the loop, ended the script, and had waybar respawning it every 5s.
    # MANGO_INSTANCE_SIGNATURE is the variable mmsg itself requires, so testing it
    # is testing the actual precondition rather than a proxy for it.
    if shutil.which("mmsg") is None or not os.environ.get("MANGO_INSTANCE_SIGNATURE"):
        return idle()

    proc = subprocess.Popen(
        ["mmsg", "watch", "focusing-client"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    if proc.stdout is None:
        return 1
    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue
        try:
            payload = json.loads(line)
        except json.JSONDecodeError:
            continue
        # An empty object is mango reporting "nothing focused" -- print a blank
        # line so the module clears rather than keeping a stale title.
        print(render(payload), flush=True)

    # mmsg exited -- mango is gone. Same treatment as never having been there.
    proc.wait()
    return idle()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
