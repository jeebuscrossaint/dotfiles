#!/bin/sh
# runit service for greetd. Install to /etc/runit/sv/greetd/run, chmod +x.
#
# tuigreet keeps its --remember state in /var/cache/tuigreet, and the greeter
# user cannot create that directory itself. Everything else the old Quickshell
# greeter needed here -- /run/greeter, a fake XDG_RUNTIME_DIR, a cache and a
# state dir -- went with it: tuigreet draws on the VT and wants none of it.
exec 2>&1

install -d -m 0755 -o greeter -g greeter /var/cache/tuigreet

exec greetd
